---
/**
 * 所有頁面共用的外框：<head> 設定、頁首、頁尾。
 * 用法：
 *   <BaseLayout title="關於我們" description="...">
 *     頁面內容
 *   </BaseLayout>
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import StyleSwitcher from '../components/preview/StyleSwitcher.astro';
import { site } from '../data/site';
import { withBase } from '../utils/url';

interface Props {
  /** 頁面標題，例如「關於我們」；首頁不需要提供 */
  title?: string;
  /** 頁面描述，未提供時使用 site.description */
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title}｜${site.title}` : `${site.title}｜${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase('/og-image.png'), Astro.site);
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#15212c" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <!-- 社群分享（Facebook、LINE 等）預覽 -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- 字體：思源黑體（中文）、JetBrains Mono（數字） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />

    <StructuredData />
  </head>
  <body>
    <StyleSwitcher current="current" />
    <a class="skip-link" href="#main">跳到主要內容</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
