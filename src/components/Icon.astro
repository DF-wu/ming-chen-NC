---
/**
 * 線條圖示。用法：<Icon name="phone" />
 * 圖示清單在 ./icons.ts。
 */
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  /** 有意義的圖示才需要提供文字說明；純裝飾不需要 */
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={icons[name]}
/>
