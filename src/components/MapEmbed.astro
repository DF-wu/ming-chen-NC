---
/**
 * 嵌入 Google 地圖（不需要 API 金鑰）。位置來自 src/data/company.ts。
 */
import { company, links } from '../data/company';
---

<div class="map">
  <iframe
    src={links.mapEmbed}
    title={`${company.name} 位置地圖`}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen></iframe>
</div>

<style>
  .map {
    position: relative;
    height: 100%;
    min-height: 360px;
    overflow: hidden;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: var(--c-line);
  }
  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
