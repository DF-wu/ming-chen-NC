---
/**
 * 頁尾：公司簡介、聯絡資訊、網站導覽、版權。
 */
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { navigation, site } from '../data/site';
import { company, fullAddress, links } from '../data/company';
import { withBase } from '../utils/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo inverse />
      <p>{site.tagline}</p>
      <p class="footer-meta">統一編號 <span class="mono">{company.taxId}</span></p>
    </div>

    <div>
      <h2 class="footer-title">聯絡資訊</h2>
      <ul class="footer-contact">
        <li>
          <Icon name="phone" size={18} />
          <span>電話 <a class="mono" href={links.tel}>{company.contact.phone}</a></span>
        </li>
        <li>
          <Icon name="fax" size={18} />
          <span>傳真 <span class="mono">{company.contact.fax}</span></span>
        </li>
        <li>
          <Icon name="mail" size={18} />
          <a href={links.mailto}>{company.contact.email}</a>
        </li>
        <li>
          <Icon name="pin" size={18} />
          <a href={links.map} target="_blank" rel="noopener">{fullAddress}</a>
        </li>
      </ul>
    </div>

    <nav aria-label="頁尾選單">
      <h2 class="footer-title">網站導覽</h2>
      <ul class="footer-nav">
        {
          navigation.map((item) => (
            <li>
              <a href={withBase(item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>© {year} {company.name}</p>
    <p>臺南市安南區・精密線切割與模具加工</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-ink);
    color: rgb(255 255 255 / 0.72);
    border-top: 3px solid var(--c-brass);
    font-size: 0.9375rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 1.5fr 0.7fr;
    gap: 40px;
    padding-block: 56px 40px;
  }

  .footer-brand p {
    margin-top: 16px;
  }
  .footer-meta {
    color: rgb(255 255 255 / 0.55);
  }

  .footer-title {
    margin-bottom: 16px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    color: var(--c-brass-light);
  }

  .footer-contact li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding-block: 4px;
  }
  .footer-contact svg {
    flex: none;
    margin-top: 0.3em;
    color: rgb(255 255 255 / 0.45);
  }

  .site-footer a {
    color: #fff;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .site-footer a:hover {
    color: var(--c-brass-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-nav li {
    padding-block: 4px;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-block: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.5);
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
