---
/**
 * 公司優勢（深色區塊）。內容來自 src/data/services.ts 的 highlights。
 */
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';
import { highlights } from '../data/services';
import { experienceYears } from '../data/company';
---

<section class="section section--dark highlights">
  <div class="container">
    <SectionHeader
      eyebrow="Why Us"
      title="為什麼選擇明泉"
      lead={`逾 ${experienceYears} 年專注精密加工，以實務經驗與持續改進的加工方法，成為客戶穩定的加工夥伴。`}
    />
    <ul class="grid">
      {
        highlights.map((item) => (
          <li class="item">
            <span class="icon">
              <Icon name={item.icon} size={26} />
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .highlights {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .item {
    padding: 32px 26px;
    background: var(--c-steel);
  }
  .icon {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-bottom: 20px;
    border-radius: 50%;
    background: rgb(224 173 76 / 0.12);
    color: var(--c-brass-light);
  }
  h3 {
    font-size: 1.125rem;
    color: #fff;
  }
  p {
    margin-top: 10px;
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 0.7);
  }

  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .item {
      padding: 26px 22px;
    }
  }
</style>
