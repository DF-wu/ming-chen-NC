---
/**
 * 內頁頂部橫幅：麵包屑、小標、頁面標題、說明。
 * 用法：<PageHero eyebrow="About" title="關於明泉" lead="..." />
 */
import { withBase } from '../utils/url';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="page-hero grid-bg">
  <div class="container">
    <nav class="breadcrumb" aria-label="目前位置">
      <ol>
        <li><a href={withBase('/')}>首頁</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
  <div class="ruler" aria-hidden="true"></div>
</section>

<style>
  .page-hero {
    border-bottom: 1px solid var(--c-line);
  }
  .container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding-block: clamp(40px, 6vw, 72px) clamp(36px, 5vw, 56px);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--c-muted);
  }
  .breadcrumb li + li::before {
    content: '/';
    margin-right: 8px;
    color: var(--c-line);
  }
  .breadcrumb a {
    text-decoration: none;
  }
  .breadcrumb a:hover {
    color: var(--c-ink);
    text-decoration: underline;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .lead {
    max-width: 640px;
    font-size: 1.125rem;
    color: var(--c-ink-2);
  }
</style>
