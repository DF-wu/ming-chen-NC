---
/**
 * 公司資料表（關於我們頁面）。內容全部取自 src/data/company.ts。
 */
import { company, address } from '../data/company';

/** 把 2002-11-18 轉成「民國 91 年 11 月 18 日（2002）」 */
function toRocDate(iso: string): string {
  const [y, m, d] = iso.split('-').map(Number);
  return `民國 ${y - 1911} 年 ${m} 月 ${d} 日（${y}）`;
}

const rows = [
  { label: '公司名稱', value: company.name },
  { label: '統一編號', value: company.taxId, mono: true },
  { label: '代表人', value: company.representative },
  { label: '開始營運', value: `民國 ${company.foundedYear - 1911} 年（${company.foundedYear}）` },
  { label: '公司設立', value: toRocDate(company.incorporatedOn) },
  {
    label: '工廠登記',
    value: `經濟部工廠登記編號 ${company.factory.registrationNo}（${company.factory.status}）`,
  },
  { label: '產業類別', value: company.factory.industries.join('、') },
  { label: '主要產品', value: company.factory.products.join('；') },
  { label: '營業項目', value: company.businessItems.join('、') },
  { label: '營業地址', value: address },
  { label: '公司登記地址', value: company.registeredAddress },
];
---

<div class="profile">
  <dl>
    {
      rows.map((row) => (
        <div class="row">
          <dt>{row.label}</dt>
          <dd class:list={{ mono: row.mono }}>{row.value}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  .profile {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .row {
    display: grid;
    grid-template-columns: 180px 1fr;
    border-bottom: 1px solid var(--c-line);
  }
  .row:last-child {
    border-bottom: 0;
  }
  dt,
  dd {
    padding: 16px 24px;
  }
  dt {
    font-weight: 500;
    color: var(--c-ink-2);
    background: var(--c-paper);
    border-right: 1px solid var(--c-line);
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
    }
    dt {
      padding-block: 10px;
      border-right: 0;
      font-size: 0.875rem;
    }
    dd {
      padding-block: 12px 14px;
    }
  }
</style>
