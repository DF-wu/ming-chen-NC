---
/**
 * 關於我們頁。
 * 公司簡介文字直接在下方修改；沿革與公司資料在 src/data/company.ts 修改。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Timeline from '../components/Timeline.astro';
import CompanyProfile from '../components/CompanyProfile.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { company, experienceYears } from '../data/company';

const roc = (year: number) => year - 1911;
const incorporatedYear = Number(company.incorporatedOn.slice(0, 4));
const factoryYear = Number(company.factory.approvedOn.slice(0, 4));
---

<BaseLayout
  title="關於我們"
  description={`${company.name}自 ${company.foundedYear} 年開始營運，以 CNC 線切割為核心技術，承接模具、夾具、治具與精密機械零件加工。`}
>
  <PageHero
    eyebrow="About"
    title="關於我們"
    lead={`自 ${company.foundedYear} 年起，專注精密線切割與模具加工。`}
  />

  <!-- 公司簡介 -->
  <section class="section">
    <div class="container intro">
      <div class="intro-text">
        <SectionHeader eyebrow="Company" title="公司簡介" />
        <p>
          {company.name}位於臺南市安南區海佃路二段，自民國 {roc(company.foundedYear)} 年（{company.foundedYear}
          年）開始營運，民國 {roc(incorporatedYear)} 年正式成立公司，並於民國 {roc(factoryYear)}
          年完成經濟部工廠登記。
        </p>
        <p>
          我們以 CNC 線切割為核心技術，提供精密、高效率的加工服務。除了一般模具加工，也承接夾具、治具與各式精密機械零件，服務臺南在地客戶，最遠至臺北。
        </p>
        <p>
          營運三年即在業界打開知名度。多年來，我們在既有技術的基礎上，持續嘗試新的、更有效率的加工方法，以穩定的品質與交期，成為客戶信賴的加工夥伴。
        </p>
      </div>

      <aside class="intro-card" aria-label="公司重點">
        <dl>
          <div>
            <dt>開始營運</dt>
            <dd class="mono">{company.foundedYear}</dd>
          </div>
          <div>
            <dt>加工經驗</dt>
            <dd><span class="mono">{experienceYears}+</span> 年</dd>
          </div>
          <div>
            <dt>核心技術</dt>
            <dd>CNC 線切割</dd>
          </div>
          <div>
            <dt>工廠狀態</dt>
            <dd>{company.factory.status}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <!-- 沿革 -->
  <section class="section section--white">
    <div class="container narrow">
      <SectionHeader eyebrow="History" title="公司沿革" />
      <Timeline />
    </div>
  </section>

  <!-- 公司資料 -->
  <section class="section">
    <div class="container narrow">
      <SectionHeader eyebrow="Profile" title="公司資料" lead="依經濟部商工登記與工廠登記公示資料。" />
      <CompanyProfile />
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .intro-text p {
    font-size: 1.0625rem;
    color: var(--c-ink-2);
  }
  .intro-text p + p {
    margin-top: 1.1em;
  }

  .intro-card {
    padding: 8px 28px;
    background: var(--c-steel);
    color: #fff;
    border-radius: var(--radius);
    border-top: 4px solid var(--c-brass);
  }
  .intro-card div {
    padding-block: 20px;
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .intro-card div:last-child {
    border-bottom: 0;
  }
  .intro-card dt {
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.6);
  }
  .intro-card dd {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--c-brass-light);
  }

  .narrow {
    max-width: calc(920px + var(--gutter) * 2);
  }

  @media (max-width: 860px) {
    .intro {
      grid-template-columns: 1fr;
    }
  }
</style>
