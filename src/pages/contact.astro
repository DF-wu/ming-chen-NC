---
/**
 * 聯絡我們頁。聯絡資訊在 src/data/company.ts 修改。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { company, fullAddress, links } from '../data/company';

/** 詢價時建議提供的資料 */
const checklist = [
  { title: '加工圖面', text: '紙本圖面可傳真，電子檔可寄 Email。' },
  { title: '材質與熱處理', text: '例如模具鋼種類、是否已淬火。' },
  { title: '數量', text: '單件試作或批量生產。' },
  { title: '希望交期', text: '方便我們安排加工排程。' },
  { title: '聯絡方式', text: '聯絡人、電話，以便回覆報價。' },
];
---

<BaseLayout
  title="聯絡我們"
  description={`${company.name}聯絡資訊：電話 ${company.contact.phone}、傳真 ${company.contact.fax}、地址 ${fullAddress}。`}
>
  <PageHero eyebrow="Contact" title="聯絡我們" lead="歡迎來電、傳真或 Email 洽詢加工需求，我們將盡快為您評估與報價。" />

  <section class="section">
    <div class="container contact-grid">
      <div class="contact-info">
        <a class="phone-card" href={links.tel}>
          <span class="phone-label"><Icon name="phone" size={20} /> 電話洽詢</span>
          <span class="phone-number mono">{company.contact.phone}</span>
          <span class="phone-hint">點擊即可撥打</span>
        </a>

        <dl class="info-list">
          <div class="info">
            <dt><Icon name="fax" size={20} /> 傳真</dt>
            <dd class="mono">{company.contact.fax}</dd>
          </div>
          <div class="info">
            <dt><Icon name="mail" size={20} /> Email</dt>
            <dd><a href={links.mailto}>{company.contact.email}</a></dd>
          </div>
          <div class="info">
            <dt><Icon name="pin" size={20} /> 地址</dt>
            <dd>
              {fullAddress}
              <span class="sub">位於海佃路二段（台 17 甲線）上</span>
            </dd>
          </div>
          <div class="info">
            <dt><Icon name="clock" size={20} /> 營業時間</dt>
            <dd>{company.contact.hours}</dd>
          </div>
          <div class="info">
            <dt><Icon name="id" size={20} /> 統一編號</dt>
            <dd class="mono">{company.taxId}</dd>
          </div>
        </dl>

        <div class="map-actions">
          <a class="btn btn--primary" href={links.directions} target="_blank" rel="noopener">
            <Icon name="route" /> 規劃路線
          </a>
          <a class="btn btn--outline" href={links.map} target="_blank" rel="noopener">
            在 Google 地圖開啟 <Icon name="external" />
          </a>
        </div>
      </div>

      <MapEmbed />
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <SectionHeader eyebrow="Inquiry" title="詢價時請提供" lead="資料越完整，越能快速提供準確的報價與交期。" />
      <ol class="checklist">
        {
          checklist.map((item, i) => (
            <li>
              <span class="check-no mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="visit-note">如需到廠洽談，請先來電聯繫，以便為您安排。</p>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: stretch;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .phone-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 28px 28px 24px;
    background: var(--c-steel);
    color: #fff;
    border-radius: var(--radius);
    border-left: 4px solid var(--c-brass);
    text-decoration: none;
    transition: background-color 0.2s;
  }
  .phone-card:hover {
    background: var(--c-steel-2);
  }
  .phone-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9375rem;
    color: rgb(255 255 255 / 0.75);
  }
  .phone-label :global(svg) {
    color: var(--c-brass-light);
  }
  .phone-number {
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 500;
    line-height: 1.25;
    color: var(--c-brass-light);
  }
  .phone-hint {
    font-size: 0.8125rem;
    color: rgb(255 255 255 / 0.55);
  }

  .info-list {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
  }
  .info {
    display: grid;
    grid-template-columns: 128px 1fr;
    gap: 12px;
    padding: 16px 22px;
    border-bottom: 1px solid var(--c-line);
  }
  .info:last-child {
    border-bottom: 0;
  }
  .info dt {
    display: flex;
    align-items: center;
    gap: 8px;
    align-self: start;
    color: var(--c-muted);
    font-size: 0.9375rem;
    line-height: 1.8;
  }
  .info dt :global(svg) {
    flex: none;
    color: var(--c-brass-text);
  }
  .info dd {
    overflow-wrap: anywhere;
  }
  .info dd a {
    color: var(--c-ink);
    text-underline-offset: 3px;
  }
  .info dd a:hover {
    color: var(--c-brass-text);
  }
  .sub {
    display: block;
    font-size: 0.875rem;
    color: var(--c-muted);
  }

  .map-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .checklist {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }
  .checklist li {
    padding: 24px 20px;
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
  }
  .check-no {
    display: block;
    margin-bottom: 10px;
    font-size: 0.875rem;
    color: var(--c-brass-text);
  }
  .checklist h3 {
    font-size: 1.0625rem;
  }
  .checklist p {
    margin-top: 6px;
    font-size: 0.9375rem;
    color: var(--c-ink-2);
  }
  .visit-note {
    margin-top: 28px;
    color: var(--c-muted);
  }

  @media (max-width: 1040px) {
    .checklist {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .checklist {
      grid-template-columns: 1fr 1fr;
    }
    .info {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .map-actions .btn {
      flex: 1 1 100%;
    }
  }
  @media (max-width: 420px) {
    .checklist {
      grid-template-columns: 1fr;
    }
  }
</style>
