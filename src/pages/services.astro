---
/**
 * 業務項目頁。各項目內容在 src/data/services.ts 修改。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { services } from '../data/services';
---

<BaseLayout
  title="業務項目"
  description="明泉精密科技的業務項目：CNC 線切割加工、模具零件加工、夾具與治具製作、精密機械零件加工。"
>
  <PageHero
    eyebrow="Services"
    title="業務項目"
    lead="以 CNC 線切割為核心技術，提供模具零件、夾具治具與精密機械零件的加工服務。"
  />

  <section class="section">
    <div class="container">
      <nav class="jump" aria-label="業務項目快速連結">
        <ul>
          {
            services.map((s) => (
              <li>
                <a href={`#${s.id}`}>
                  <Icon name={s.icon} size={20} />
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="service-list">
        {
          services.map((s, i) => (
            <article class="service" id={s.id}>
              <header class="service-head">
                <span class="service-no mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="service-icon">
                  <Icon name={s.icon} size={34} />
                </span>
                <h2>{s.title}</h2>
                <p class="service-en mono">{s.en}</p>
              </header>

              <div class="service-body">
                <p class="service-desc">{s.description}</p>

                <h3>服務內容</h3>
                <ul class="points">
                  {s.points.map((point) => (
                    <li>
                      <Icon name="check" size={20} />
                      {point}
                    </li>
                  ))}
                </ul>

                {s.materials && (
                  <div class="materials">
                    <h3>適用材料</h3>
                    <ul class="tags">
                      {s.materials.map((m) => (
                        <li>{m}</li>
                      ))}
                    </ul>
                    <p class="note">實際可加工的材質、尺寸與精度，歡迎來電洽詢。</p>
                  </div>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <ProcessSteps />
  <ContactCTA />
</BaseLayout>

<style>
  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: clamp(36px, 5vw, 56px);
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-surface);
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .jump a:hover {
    border-color: var(--c-brass);
    color: var(--c-brass-text);
  }
  .jump :global(svg) {
    color: var(--c-brass-text);
  }

  .service-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .service {
    display: grid;
    grid-template-columns: 300px 1fr;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .service-head {
    position: relative;
    padding: 36px 32px;
    background: var(--c-steel);
    color: #fff;
  }
  .service-no {
    position: absolute;
    top: 28px;
    right: 28px;
    font-size: 0.875rem;
    color: rgb(255 255 255 / 0.5);
  }
  .service-icon {
    display: inline-grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: 24px;
    border: 1.5px solid var(--c-brass-light);
    border-radius: var(--radius);
    color: var(--c-brass-light);
  }
  .service-head h2 {
    font-size: 1.5rem;
  }
  .service-en {
    margin-top: 4px;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--c-brass-light);
  }

  .service-body {
    padding: 36px clamp(24px, 4vw, 44px);
  }
  .service-desc {
    font-size: 1.0625rem;
    color: var(--c-ink-2);
  }
  .service-body h3 {
    margin: 28px 0 12px;
    font-size: 1rem;
    color: var(--c-ink);
  }
  .points {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 24px;
  }
  .points li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .points :global(svg) {
    flex: none;
    margin-top: 0.3em;
    color: var(--c-brass);
  }

  .materials {
    margin-top: 8px;
    padding-top: 4px;
    border-top: 1px dashed var(--c-line);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tags li {
    padding: 4px 12px;
    border-radius: 4px;
    background: var(--c-paper);
    border: 1px solid var(--c-line);
    font-size: 0.9375rem;
  }
  .note {
    margin-top: 12px;
    font-size: 0.875rem;
    color: var(--c-muted);
  }

  @media (max-width: 860px) {
    .service {
      grid-template-columns: 1fr;
    }
    .service-head {
      padding: 28px 24px;
    }
    .service-icon {
      width: 56px;
      height: 56px;
      margin-bottom: 16px;
    }
  }
  @media (max-width: 560px) {
    .points {
      grid-template-columns: 1fr;
    }
    .service-body {
      padding: 28px 22px;
    }
  }
</style>
