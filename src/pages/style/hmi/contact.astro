---
/**
 * 控制面板風格 — 聯絡我們頁。聯絡資訊在 src/data/company.ts 修改。
 */
import Layout from '../../../themes/hmi/Layout.astro';
import PageHead from '../../../themes/hmi/components/PageHead.astro';
import ContactConsole from '../../../themes/hmi/components/ContactConsole.astro';
import MapPanel from '../../../themes/hmi/components/MapPanel.astro';
import { company, fullAddress } from '../../../data/company';

/** 詢價時建議提供的資料 */
const checklist = [
  { title: '加工圖面', text: '紙本圖面可傳真，電子檔可寄 Email。' },
  { title: '材質與熱處理', text: '例如模具鋼種類、是否已淬火。' },
  { title: '數量', text: '單件試作或批量生產。' },
  { title: '希望交期', text: '方便我們安排加工排程。' },
  { title: '聯絡方式', text: '聯絡人、電話，以便回覆報價。' },
];
---

<Layout
  title="聯絡我們"
  canonicalPath="/contact/"
  description={`${company.name}聯絡資訊：電話 ${company.contact.phone}、傳真 ${company.contact.fax}、地址 ${fullAddress}。`}>
  <PageHead title="聯絡我們" en="CONTACT" lead="歡迎來電、傳真或 Email 洽詢加工需求，我們將盡快為您評估與報價。" />

  <section class="hmi-section">
    <div class="hmi-wrap stack">
      <ContactConsole full title="聯絡資訊" />

      <div class="split">
        <MapPanel />

        <div class="hmi-panel input reveal" style="--reveal-delay: 0.1s">
          <header class="hmi-titlebar">
            <h2>詢價時請提供</h2>
            <span class="tb-en">INPUT</span>
          </header>
          <ol class="fields">
            {
              checklist.map((item) => (
                <li class="field">
                  <span class="field-label">{item.title}</span>
                  <span class="field-box">{item.text}</span>
                </li>
              ))
            }
          </ol>
          <p class="note">資料越完整，越能快速提供準確的報價與交期。如需到廠洽談，請先來電聯繫，以便為您安排。</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  .fields {
    padding: 10px 20px 4px;
  }
  .field {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 14px;
    align-items: center;
    padding-block: 9px;
  }
  .field-label {
    font-weight: 700;
    color: var(--hmi-text);
  }
  /* 像控制器的參數輸入欄 */
  .field-box {
    position: relative;
    padding: 9px 12px 9px 14px;
    background: var(--hmi-screen);
    border: 1px solid var(--hmi-line);
    font-size: 0.9375rem;
    color: var(--hmi-text-2);
  }
  .field-box::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--hmi-yellow);
  }
  .note {
    padding: 14px 20px 22px;
    font-size: 0.9375rem;
    color: var(--hmi-muted);
  }

  @media (max-width: 960px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .fields {
      padding-inline: 16px;
    }
    .field {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .note {
      padding-inline: 16px;
    }
  }
</style>
