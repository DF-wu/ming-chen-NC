---
/**
 * 「鋼與光」風格：聯絡我們。聯絡資訊在 src/data/company.ts 修改。
 */
import Layout from '../../../themes/spark/Layout.astro';
import PageIntro from '../../../themes/spark/PageIntro.astro';
import Icon from '../../../components/Icon.astro';
import { company, fullAddress, links } from '../../../data/company';

/** 詢價時建議提供的資料 */
const checklist = [
  { title: '加工圖面', text: '紙本圖面可傳真，電子檔可寄 Email。' },
  { title: '材質與熱處理', text: '例如模具鋼種類、是否已淬火。' },
  { title: '數量', text: '單件試作或批量生產。' },
  { title: '希望交期', text: '方便安排加工排程。' },
  { title: '聯絡方式', text: '聯絡人與電話，以便回覆報價。' },
];
---

<Layout
  title="聯絡我們"
  canonicalPath="/contact/"
  description={`${company.name}聯絡資訊：電話 ${company.contact.phone}、傳真 ${company.contact.fax}、地址 ${fullAddress}。`}
>
  <PageIntro title="聯絡我們" en="CONTACT" lead="歡迎來電、傳真或 Email 洽詢加工需求，我們將盡快為您評估與報價。" />

  <section class="sp-section top">
    <div class="sp-container">
      <!-- 電話：最大、最先看到 -->
      <div class="phone-row">
        <p class="sp-label">電話</p>
        <a class="phone sp-metal sp-num" href={links.tel}>{company.contact.phone}</a>
        <p class="hint">手機點擊即可撥打</p>
      </div>

      <!-- 其他聯絡資訊 -->
      <dl class="specs">
        <div>
          <dt class="sp-label"><Icon name="fax" size={16} /> 傳真</dt>
          <dd class="sp-num">{company.contact.fax}</dd>
        </div>
        <div>
          <dt class="sp-label"><Icon name="mail" size={16} /> Email</dt>
          <dd><a href={links.mailto}>{company.contact.email}</a></dd>
        </div>
        <div class="wide">
          <dt class="sp-label"><Icon name="pin" size={16} /> 地址</dt>
          <dd>
            {fullAddress}
            <span class="sub">位於海佃路二段（台 17 甲線）上</span>
          </dd>
        </div>
        <div>
          <dt class="sp-label"><Icon name="clock" size={16} /> 營業時間</dt>
          <dd>{company.contact.hours}</dd>
        </div>
        <div>
          <dt class="sp-label"><Icon name="id" size={16} /> 統一編號</dt>
          <dd class="sp-num">{company.taxId}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 地圖 -->
  <section class="map-section">
    <div class="sp-container">
      <div class="sp-frame map-frame">
        <div class="sp-frame-inner">
          <iframe
            src={links.mapEmbed}
            title={`${company.name} 位置地圖`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
      </div>
      <div class="map-actions">
        <a class="sp-btn sp-btn--copper" href={links.directions} target="_blank" rel="noopener">
          <Icon name="route" /> 規劃路線
        </a>
        <a class="sp-btn" href={links.map} target="_blank" rel="noopener">
          在 Google 地圖開啟 <Icon name="external" />
        </a>
      </div>
    </div>
  </section>

  <!-- 詢價須知 -->
  <section class="sp-section">
    <div class="sp-container inquiry">
      <div>
        <h2 data-reveal>詢價時請提供</h2>
        <p class="inquiry-lead" data-reveal style="--delay: 0.08s">資料越完整，越能快速提供準確的報價與交期。</p>
      </div>
      <div>
        <ol class="checklist">
          {
            checklist.map((item, i) => (
              <li data-reveal style={`--delay: ${i * 0.06}s`}>
                <span class="idx sp-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="item-title">{item.title}</span>
                <span class="item-text">{item.text}</span>
              </li>
            ))
          }
        </ol>
        <p class="visit">如需到廠洽談，請先來電聯繫，以便為您安排。</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .top {
    padding-top: clamp(40px, 6vw, 80px);
  }
  .phone-row {
    padding-bottom: clamp(28px, 4vw, 48px);
  }
  .phone {
    display: block;
    width: fit-content;
    margin-block: 8px 10px;
    font-size: clamp(3rem, 11vw, 8.5rem);
    font-weight: 200;
    line-height: 1;
    text-decoration: none;
    transition: background-position 1.2s ease;
  }
  .phone:hover {
    background-position: 100% 50%;
  }
  .hint {
    font-size: 0.875rem;
    color: var(--sp-muted);
  }

  /* 格線：用 1px 間隙露出底色，欄數改變時不必另外處理邊框 */
  .specs {
    display: grid;
    grid-template-columns: 0.9fr 1.5fr 1.9fr 0.9fr 0.9fr;
    gap: 1px;
    background: var(--sp-line);
    border-top: 1px solid var(--sp-line-strong);
    border-bottom: 1px solid var(--sp-line-strong);
  }
  .specs > div {
    padding: 22px 20px;
    background: var(--sp-bg);
  }
  .specs dt {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .specs dt :global(svg) {
    color: var(--sp-copper);
  }
  .specs dd {
    margin-top: 6px;
    font-size: 1.0625rem;
    overflow-wrap: anywhere;
  }
  .specs a {
    color: var(--sp-text);
    text-decoration-color: rgb(214 160 101 / 0.5);
    text-underline-offset: 4px;
  }
  .specs a:hover {
    color: var(--sp-copper-2);
  }
  .sub {
    display: block;
    font-size: 0.875rem;
    color: var(--sp-muted);
  }

  .map-frame {
    --c: 24px;
    height: clamp(340px, 52vh, 520px);
  }
  .map-frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    /* 讓地圖融入深色版面（反轉明暗、保留色相） */
    filter: invert(0.9) hue-rotate(180deg) saturate(0.6) brightness(0.95) contrast(0.9);
  }
  .map-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }

  .inquiry {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.5fr);
    gap: 32px clamp(40px, 7vw, 112px);
  }
  .inquiry h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: 0.06em;
  }
  .inquiry-lead {
    margin-top: 16px;
    color: var(--sp-text-2);
  }
  .checklist {
    border-top: 1px solid var(--sp-line-strong);
  }
  .checklist li {
    display: grid;
    grid-template-columns: 3em 9em 1fr;
    align-items: baseline;
    gap: 8px 16px;
    padding-block: 18px;
    border-bottom: 1px solid var(--sp-line);
  }
  .idx {
    color: var(--sp-copper);
    font-size: 0.9375rem;
  }
  .item-title {
    font-weight: 500;
  }
  .item-text {
    color: var(--sp-text-2);
    font-size: 0.9375rem;
  }
  .visit {
    margin-top: 24px;
    color: var(--sp-muted);
  }

  @media (max-width: 1100px) {
    .specs {
      grid-template-columns: 1fr 1fr;
    }
    .specs .wide {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 960px) {
    .inquiry {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .specs {
      grid-template-columns: 1fr;
    }
    .specs > div {
      padding: 16px 4px;
    }
    .checklist li {
      grid-template-columns: 2.5em 1fr;
    }
    .item-text {
      grid-column: 2;
    }
    .map-actions .sp-btn {
      flex: 1 1 100%;
    }
  }
</style>
