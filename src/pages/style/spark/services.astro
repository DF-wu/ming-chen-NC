---
/**
 * 「鋼與光」風格：業務項目。內容來自 src/data/services.ts。
 */
import Layout from '../../../themes/spark/Layout.astro';
import PageIntro from '../../../themes/spark/PageIntro.astro';
import ContactBand from '../../../themes/spark/ContactBand.astro';
import { services, processSteps } from '../../../data/services';
---

<Layout
  title="業務項目"
  canonicalPath="/services/"
  description="明泉精密科技的業務項目：CNC 線切割加工、模具零件加工、夾具與治具製作、精密機械零件加工。"
>
  <PageIntro
    title="業務項目"
    en="SERVICES"
    lead="以 CNC 線切割為核心技術，提供模具零件、夾具治具與精密機械零件的加工服務。"
  />

  <!-- 快速跳轉 -->
  <section class="jump-wrap">
    <div class="sp-container">
      <nav class="jump" aria-label="業務項目快速連結">
        {
          services.map((s) => (
            <a href={`#${s.id}`}>
              <span class="sp-label">{s.en}</span>
              <span class="jump-title">{s.title}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- 各項業務 -->
  <div class="sp-container list">
    {
      services.map((s) => (
        <section class="svc" id={s.id} aria-labelledby={`${s.id}-title`}>
          <header class="svc-head" data-reveal>
            <p class="sp-label">{s.en}</p>
            <h2 id={`${s.id}-title`}>{s.title}</h2>
          </header>

          <div class="svc-body">
            <p class="svc-desc" data-reveal>
              {s.description}
            </p>

            <div class="svc-block" data-reveal style="--delay: 0.08s">
              <h3 class="sp-label">服務內容</h3>
              <ul class="points">
                {s.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>

            {s.materials && (
              <div class="svc-block" data-reveal style="--delay: 0.12s">
                <h3 class="sp-label">適用材料</h3>
                <p class="materials">
                  {s.materials.map((m, i) => (
                    <>
                      {i > 0 && <span class="slash" aria-hidden="true">／</span>}
                      <span>{m}</span>
                    </>
                  ))}
                </p>
                <p class="note">實際可加工的材質、尺寸與精度，歡迎來電洽詢。</p>
              </div>
            )}
          </div>
        </section>
      ))
    }
  </div>

  <!-- 合作流程 -->
  <section class="sp-section flow-section">
    <div class="sp-container">
      <div class="flow-head">
        <h2 data-reveal>從圖面到交貨</h2>
        <p data-reveal style="--delay: 0.08s">歡迎直接來電，或傳真、Email 圖面詢價。</p>
      </div>
      <ol class="flow">
        {
          processSteps.map((step, i) => (
            <li data-reveal style={`--delay: ${i * 0.08}s`}>
              <span class="flow-step sp-label">STEP {i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <ContactBand />
</Layout>

<style>
  .jump-wrap {
    padding-block: clamp(28px, 4vw, 48px) 0;
  }
  .jump {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--sp-line-strong);
  }
  .jump a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 18px 22px;
    color: var(--sp-text);
    text-decoration: none;
    transition: background-color 0.25s;
  }
  .jump a + a {
    border-left: 1px solid var(--sp-line-strong);
  }
  .jump a:hover {
    background: rgb(255 255 255 / 0.04);
  }
  .jump a:hover .jump-title {
    color: var(--sp-copper-2);
  }
  .jump-title {
    font-size: 1.0625rem;
    transition: color 0.25s;
  }

  .list {
    padding-block: clamp(40px, 6vw, 80px) 0;
  }
  .svc {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr);
    gap: 32px clamp(32px, 6vw, 96px);
    padding-block: clamp(48px, 7vw, 96px);
    border-top: 1px solid var(--sp-line-strong);
  }
  .svc-head {
    align-self: start;
    position: sticky;
    top: calc(var(--sp-header-h) + 32px);
  }
  .svc-head h2 {
    margin-top: 12px;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 300;
    line-height: 1.25;
    letter-spacing: 0.06em;
  }
  .svc-desc {
    font-size: clamp(1.125rem, 1.6vw, 1.3125rem);
    font-weight: 300;
    line-height: 1.9;
    color: var(--sp-text);
  }
  .svc-block {
    margin-top: 40px;
  }
  .svc-block h3 {
    margin-bottom: 12px;
  }
  .points {
    border-top: 1px solid var(--sp-line);
  }
  .points li {
    position: relative;
    padding: 14px 0 14px 28px;
    border-bottom: 1px solid var(--sp-line);
    color: var(--sp-text);
  }
  /* 項目符號：小小的放電點 */
  .points li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-top: -3px;
    background: var(--sp-copper);
    transform: rotate(45deg);
  }
  .materials {
    font-size: 1.0625rem;
    line-height: 2;
  }
  .slash {
    margin-inline: 0.4em;
    color: var(--sp-muted);
  }
  .note {
    margin-top: 10px;
    font-size: 0.875rem;
    color: var(--sp-muted);
  }

  .flow-section {
    margin-top: clamp(24px, 4vw, 48px);
    background: var(--sp-bg-2);
    border-top: 1px solid var(--sp-line);
  }
  .flow-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 40px;
    margin-bottom: clamp(32px, 4vw, 48px);
  }
  .flow-head h2 {
    font-size: clamp(2rem, 4.4vw, 3.5rem);
    font-weight: 300;
    letter-spacing: 0.08em;
  }
  .flow-head p {
    color: var(--sp-text-2);
  }
  .flow {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--sp-line-strong);
  }
  .flow li {
    position: relative;
    padding: 28px 28px 8px 0;
  }
  .flow li + li {
    padding-left: 28px;
    border-left: 1px solid var(--sp-line);
  }
  /* 頂端銅色刻度，像加工進度 */
  .flow li::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 48px;
    height: 1px;
    background: var(--sp-copper);
  }
  .flow h3 {
    margin-top: 12px;
    font-size: 1.1875rem;
    font-weight: 500;
  }
  .flow p {
    margin-top: 8px;
    font-size: 0.9375rem;
    color: var(--sp-text-2);
  }

  @media (max-width: 960px) {
    .jump {
      grid-template-columns: 1fr 1fr;
    }
    .jump a:nth-child(3) {
      border-left: 0;
    }
    .jump a:nth-child(n + 3) {
      border-top: 1px solid var(--sp-line-strong);
    }
    .svc {
      grid-template-columns: 1fr;
    }
    .svc-head {
      position: static;
    }
    .flow {
      grid-template-columns: 1fr 1fr;
    }
    .flow li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .flow li:nth-child(n + 3) {
      border-top: 1px solid var(--sp-line);
    }
  }
  @media (max-width: 560px) {
    .jump a {
      padding: 14px 16px;
    }
    .jump .sp-label {
      display: none;
    }
    .flow {
      grid-template-columns: 1fr;
    }
    .flow li,
    .flow li + li {
      padding: 22px 0 18px;
      border-left: 0;
    }
    .flow li + li {
      border-top: 1px solid var(--sp-line);
    }
  }
</style>
