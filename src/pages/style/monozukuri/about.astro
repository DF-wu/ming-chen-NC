---
/**
 * 精工極簡風格 —— 關於我們
 * 簡介文字在下方修改；沿革與公司資料在 src/data/company.ts 修改。
 */
import Layout from '../../../themes/monozukuri/Layout.astro';
import PageTitle from '../../../themes/monozukuri/components/PageTitle.astro';
import SectionHead from '../../../themes/monozukuri/components/SectionHead.astro';
import ContactBlock from '../../../themes/monozukuri/components/ContactBlock.astro';
import { company, experienceYears, timeline } from '../../../data/company';
import { kanjiDigits, kanjiNumber, profileRows, rocYear, yearOf } from '../../../themes/monozukuri/lib/format';

const incorporated = yearOf(company.incorporatedOn);
const factoryYear = yearOf(company.factory.approvedOn);
const rows = profileRows();
---

<Layout
  title="關於我們"
  canonicalPath="/about/"
  description={`${company.name}自 ${company.foundedYear} 年開始營運，以 CNC 線切割為核心技術，承接模具、夾具、治具與精密機械零件加工。`}
>
  <PageTitle title="關於明泉" lead={`自${kanjiDigits(company.foundedYear)}年起，專注精密線切割與模具加工。`} />

  <!-- 簡介：左標題、中內文、右直書引言 -->
  <section class="section">
    <div class="wrap intro">
      <h2 data-reveal>公司簡介</h2>
      <div class="intro-body">
        <p data-reveal>
          {company.name}位於臺南市安南區海佃路二段。自民國 {rocYear(company.foundedYear)} 年（{company.foundedYear}）開始營運，
          {`民國 ${rocYear(incorporated)} 年正式成立公司，並於民國 ${rocYear(factoryYear)} 年完成經濟部工廠登記。`}
        </p>
        <p data-reveal>
          我們以 CNC 線切割為核心技術，提供精密、高效率的加工服務。除了一般模具加工，也承接夾具、治具與各式精密機械零件，服務臺南在地客戶，最遠至臺北。
        </p>
        <p data-reveal>
          在既有技術的基礎上，我們持續嘗試新的、更有效率的加工方法，以穩定的品質與交期，成為客戶信賴的加工夥伴。
        </p>
      </div>
      <blockquote class="quote" data-reveal>
        <p>營運三年，即在業界打開知名度。</p>
      </blockquote>
    </div>
  </section>

  <!-- 沿革 -->
  <section class="section section--tint">
    <div class="wrap narrow">
      <SectionHead title="沿革" note={`開始營運至今逾${kanjiNumber(experienceYears)}年`} />
      <ol class="history">
        {
          timeline.map((item, i) => (
            <li class:list={['h-row', { 'h-row--now': i === timeline.length - 1 }]} data-reveal style={`--delay:${i * 0.1}s`}>
              <p class="h-year num">{item.year}</p>
              <p class="h-era">{item.era}</p>
              <div class="h-body">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 公司資料 -->
  <section class="section">
    <div class="wrap narrow">
      <SectionHead title="公司資料" note="依經濟部商工登記與工廠登記公示資料" />
      <dl class="profile" data-reveal>
        {
          rows.map((row) => (
            <div class="p-row">
              <dt>{row.label}</dt>
              <dd>
                {row.value}
                {row.note && <span class="p-note">{row.note}</span>}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <ContactBlock />
</Layout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr) auto;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .intro h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    letter-spacing: 0.14em;
  }
  .intro-body p {
    font-size: 1.0625rem;
    line-height: 2.1;
    color: var(--ink-2);
  }
  .intro-body p + p {
    margin-top: 1.4em;
  }
  .quote {
    margin: 0;
    padding-left: 24px;
    border-left: 1px solid var(--shu);
  }
  .quote p {
    writing-mode: vertical-rl;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    letter-spacing: 0.32em;
    line-height: 1.8;
  }

  .narrow {
    max-width: calc(980px + var(--gutter) * 2);
  }

  .history {
    border-top: 1px solid var(--ink);
  }
  .h-row {
    display: grid;
    grid-template-columns: 120px 120px minmax(0, 1fr);
    gap: 24px;
    align-items: baseline;
    padding-block: 28px;
    border-bottom: 1px solid var(--line);
  }
  .h-year {
    font-size: 1.75rem;
    line-height: 1.2;
  }
  .h-row--now .h-year {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--shu);
  }
  .h-era {
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .h-body h3 {
    font-size: 1.1875rem;
    letter-spacing: 0.1em;
  }
  .h-body p {
    margin-top: 6px;
    color: var(--ink-2);
  }

  .profile {
    border-top: 1px solid var(--ink);
  }
  .p-row {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 24px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }
  .p-row dt {
    font-size: 0.9375rem;
    letter-spacing: 0.14em;
    color: var(--muted);
  }
  .p-note {
    margin-left: 14px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  @media (max-width: 960px) {
    .intro {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .intro h2 {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .intro {
      grid-template-columns: 1fr;
    }
    .quote {
      padding-left: 0;
      padding-top: 20px;
      border-left: 0;
      border-top: 1px solid var(--shu);
    }
    .quote p {
      writing-mode: horizontal-tb;
      font-size: 1.125rem;
      letter-spacing: 0.16em;
    }
    .h-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .h-era {
      margin-top: -2px;
    }
    .h-body {
      margin-top: 8px;
    }
    .p-row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .p-note {
      margin-left: 10px;
    }
  }
</style>
