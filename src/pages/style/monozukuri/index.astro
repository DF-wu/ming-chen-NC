---
/**
 * 精工極簡風格 —— 首頁
 */
import Layout from '../../../themes/monozukuri/Layout.astro';
import HeroDrawing from '../../../themes/monozukuri/components/HeroDrawing.astro';
import SectionHead from '../../../themes/monozukuri/components/SectionHead.astro';
import ProcessList from '../../../themes/monozukuri/components/ProcessList.astro';
import ContactBlock from '../../../themes/monozukuri/components/ContactBlock.astro';
import { company, experienceYears, links } from '../../../data/company';
import { services } from '../../../data/services';
import { formalNumber, kanjiDigits, kanjiNumber, rocYear, yearOf } from '../../../themes/monozukuri/lib/format';
import { styleUrl } from '../../../utils/url';

const incorporated = yearOf(company.incorporatedOn);
const factoryYear = yearOf(company.factory.approvedOn);

/** 「記錄」表：營運的幾個關鍵年份 */
const records = [
  { year: company.foundedYear, label: '開始營運', text: `民國 ${rocYear(company.foundedYear)} 年，投入精密模具與 CNC 線切割加工。` },
  { year: incorporated, label: '公司設立', text: `${company.name}經臺南市政府核准設立。` },
  { year: factoryYear, label: '工廠登記', text: `經濟部工廠登記 第 ${company.factory.registrationNo} 號。` },
];
---

<Layout>
  <!-- 主視覺：直書標語＋線切割加工路徑 -->
  <section class="hero">
    <div class="wrap hero-grid">
      <h1 class="hero-title" aria-label="一條線，切出精度。">
        <span class="line" style="--d:.2s">一條線，</span><span class="line" style="--d:.9s">切出精度。</span>
      </h1>

      <div class="hero-text">
        <p class="hero-meta"><span>臺南市安南區</span><span>自{kanjiDigits(company.foundedYear)}年</span></p>
        <p class="hero-lead">
          {company.name}以 CNC 線切割為核心技術，承接模具零件、夾具、治具與各式精密機械零件加工。
        </p>
        <ul class="hero-links">
          <li>
            <a class="hero-tel" href={links.tel}>
              <span class="caption">電話洽詢</span>
              <span class="num">{company.contact.phone}</span>
            </a>
          </li>
          <li>
            <a class="text-link" href={styleUrl('monozukuri', '/services/')}>
              業務內容 <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="hero-figure">
        <HeroDrawing />
      </div>
    </div>
  </section>

  <!-- 業務內容：一列一項的目錄式清單 -->
  <section class="section">
    <div class="wrap">
      <SectionHead title="業務內容" note="以 CNC 線切割為核心的四項加工" />
      <ol class="svc">
        {
          services.map((s, i) => (
            <li data-reveal style={`--delay:${i * 0.08}s`}>
              <a class="svc-row" href={styleUrl('monozukuri', `/services/#${s.id}`)}>
                <span class="svc-no" aria-hidden="true">
                  {formalNumber(i + 1)}
                </span>
                <span class="svc-name">
                  <span class="svc-title">{s.title}</span>
                  <span class="svc-en">{s.en}</span>
                </span>
                <span class="svc-sum">{s.summary}</span>
                <span class="svc-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 關於：左側明體標語、右側敘述與記錄表 -->
  <section class="section section--tint">
    <div class="wrap about">
      <div class="about-head">
        <h2 data-reveal>
          {kanjiNumber(experienceYears)}餘年，<br />專注於一條線的精度。
        </h2>
      </div>
      <div class="about-body">
        <p data-reveal>
          自民國 {rocYear(company.foundedYear)} 年開始營運，營運三年即在業界打開知名度。我們在既有技術的基礎上，持續嘗試新的、更有效率的加工方法，以精密、高效率的加工服務臺南在地與遠至臺北的客戶。
        </p>

        <table class="records" data-reveal style="--delay:.1s">
          <caption class="visually-hidden">營運記錄</caption>
          <tbody>
            {
              records.map((r) => (
                <tr>
                  <th scope="row" class="num">{r.year}</th>
                  <td class="rec-label">{r.label}</td>
                  <td>{r.text}</td>
                </tr>
              ))
            }
            <tr class="now">
              <th scope="row">現在</th>
              <td class="rec-label">工廠狀態</td>
              <td><span class="dot" aria-hidden="true"></span>{company.factory.status}</td>
            </tr>
          </tbody>
        </table>

        <a class="text-link" href={styleUrl('monozukuri', '/about/')}>
          關於明泉 <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <ProcessList />
  <ContactBlock />
</Layout>

<style>
  /* 主視覺 ------------------------------------------------- */
  .hero {
    padding-block: clamp(48px, 7vw, 104px) clamp(8px, 2vw, 24px);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 0.9fr) auto;
    grid-template-areas: 'figure text title';
    gap: clamp(32px, 4.5vw, 72px);
    align-items: start;
  }
  /* 直書標語：h1 本身直排，兩行各為一個區塊（由右而左排列） */
  .hero-title {
    grid-area: title;
    writing-mode: vertical-rl;
    font-size: clamp(2.5rem, 4.4vw, 3.75rem);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: 0.2em;
  }
  .hero-title .line {
    display: block;
  }
  :global(.js) .hero-title .line {
    animation: ink-in 1.6s cubic-bezier(0.2, 0.6, 0.2, 1) var(--d) both;
  }
  @keyframes ink-in {
    from {
      opacity: 0;
      clip-path: inset(0 0 100% 0);
    }
    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }

  .hero-text {
    grid-area: text;
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-top: 8px;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.2em;
    white-space: nowrap;
    font-family: var(--font-serif);
    font-size: 0.875rem;
    letter-spacing: 0.24em;
    color: var(--ink-2);
  }
  .hero-lead {
    font-size: 1.0625rem;
    line-height: 2.1;
    color: var(--ink-2);
  }
  .hero-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    margin-top: 8px;
  }
  .hero-tel {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }
  .hero-tel .num {
    font-size: 1.75rem;
    line-height: 1.3;
    transition: color 0.25s;
  }
  .hero-tel:hover .num {
    color: var(--shu);
  }

  .hero-figure {
    grid-area: figure;
  }

  /* 業務清單 ----------------------------------------------- */
  .svc {
    border-top: 1px solid var(--ink);
  }
  .svc li {
    border-bottom: 1px solid var(--line);
  }
  .svc-row {
    position: relative;
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.35fr) 40px;
    gap: 24px;
    align-items: baseline;
    padding: 34px 0;
    text-decoration: none;
    transition: background-color 0.3s;
  }
  /* 滑過時一條朱色線由左延伸 */
  .svc-row::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--shu);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .svc-row:hover::after {
    transform: scaleX(1);
  }
  .svc-no {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--muted);
  }
  .svc-name {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .svc-title {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.4;
  }
  .svc-en {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .svc-sum {
    color: var(--ink-2);
  }
  .svc-arrow {
    justify-self: end;
    font-size: 1.125rem;
    transition:
      transform 0.3s,
      color 0.3s;
  }
  .svc-row:hover .svc-arrow {
    transform: translateX(6px);
    color: var(--shu);
  }

  /* 關於 --------------------------------------------------- */
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: clamp(40px, 7vw, 120px);
  }
  .about h2 {
    font-size: clamp(1.75rem, 3.4vw, 2.625rem);
    line-height: 1.6;
    letter-spacing: 0.12em;
  }
  .about-body > p {
    color: var(--ink-2);
  }
  .records {
    width: 100%;
    margin-block: 40px 36px;
    border-collapse: collapse;
    border-top: 1px solid var(--ink);
  }
  .records th,
  .records td {
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: baseline;
  }
  .records th {
    width: 92px;
    font-size: 1.125rem;
    font-weight: 400;
  }
  .records .now th {
    font-family: var(--font-serif);
    font-size: 1rem;
  }
  .rec-label {
    width: 96px;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 10px;
    background: var(--shu);
    border-radius: 50%;
    vertical-align: 0.1em;
  }
  :global(.js) .dot {
    animation: blink 2.4s ease-in-out infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  /* 版面調整 ----------------------------------------------- */
  @media (max-width: 1080px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'text title'
        'figure figure';
    }
    .hero-figure {
      max-width: 720px;
    }
  }
  @media (max-width: 860px) {
    .svc-row {
      grid-template-columns: 40px minmax(0, 1fr) 28px;
      grid-template-areas:
        'no name arrow'
        'no sum sum';
      row-gap: 10px;
      padding: 26px 0;
    }
    .svc-no {
      grid-area: no;
    }
    .svc-name {
      grid-area: name;
    }
    .svc-sum {
      grid-area: sum;
      font-size: 0.9375rem;
    }
    .svc-arrow {
      grid-area: arrow;
    }
    .about {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .hero-grid {
      gap: 36px 20px;
    }
    .hero-title {
      font-size: 2.125rem;
      letter-spacing: 0.16em;
    }
    .hero-lead {
      font-size: 1rem;
    }
    .records th {
      width: 64px;
      font-size: 1rem;
    }
    .rec-label {
      width: 76px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero-title .line,
    :global(.js) .dot {
      animation: none;
    }
  }
</style>
