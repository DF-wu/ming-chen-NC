---
/**
 * 細線框成的聯絡資訊列（首頁主視覺下方），電話、傳真、地址一眼可見。
 */
import Icon from '../../components/Icon.astro';
import { company, fullAddress, links } from '../../data/company';
import { styleUrl } from '../../utils/url';
---

<div class="strip">
  <a class="cell cell--tel" href={links.tel}>
    <span class="sp-label">電話</span>
    <span class="tel sp-num">{company.contact.phone}</span>
  </a>
  <div class="cell">
    <span class="sp-label">傳真</span>
    <span class="val sp-num">{company.contact.fax}</span>
  </div>
  <a class="cell" href={links.map} target="_blank" rel="noopener">
    <span class="sp-label">地址</span>
    <span class="val">{fullAddress}</span>
  </a>
  <a class="cell cell--go" href={styleUrl('spark', '/contact/')}>
    <span class="go">聯絡資訊與地圖 <Icon name="arrowRight" size={18} /></span>
  </a>
</div>

<style>
  .strip {
    display: grid;
    grid-template-columns: 1.15fr 0.9fr 1.6fr 1fr;
    border: 1px solid var(--sp-line-strong);
    border-top: 0;
  }
  .cell {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-height: 92px;
    padding: 18px 24px;
    text-decoration: none;
    color: var(--sp-text);
  }
  .cell + .cell {
    border-left: 1px solid var(--sp-line-strong);
  }
  a.cell {
    transition: background-color 0.25s;
  }
  a.cell:hover {
    background: rgb(255 255 255 / 0.035);
  }
  .tel {
    font-size: 1.625rem;
    font-weight: 400;
    line-height: 1.2;
    color: var(--sp-copper);
  }
  .val {
    font-size: 1rem;
    color: var(--sp-text);
  }
  .cell--go {
    align-items: flex-start;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 500;
    color: var(--sp-copper);
  }
  .cell--go:hover .go {
    color: var(--sp-copper-2);
  }
  .go :global(svg) {
    transition: transform 0.25s;
  }
  .cell--go:hover .go :global(svg) {
    transform: translateX(4px);
  }

  @media (max-width: 1000px) {
    .strip {
      grid-template-columns: 1fr 1fr;
    }
    .cell:nth-child(3) {
      border-left: 0;
    }
    .cell:nth-child(n + 3) {
      border-top: 1px solid var(--sp-line-strong);
    }
  }
  @media (max-width: 560px) {
    .strip {
      grid-template-columns: 1fr;
    }
    .cell + .cell {
      border-left: 0;
      border-top: 1px solid var(--sp-line-strong);
    }
    .cell {
      min-height: 0;
      padding: 16px 18px;
    }
    .cell:nth-child(2) {
      display: none; /* 手機省略傳真，保留在聯絡頁與頁尾 */
    }
  }
</style>
