---
/**
 * 業務項目索引（首頁）：一列一項，滑過時一道銅色切割線從左劃到右。
 * 內容來自 src/data/services.ts。
 */
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';
import { styleUrl } from '../../utils/url';
---

<ul class="index">
  {
    services.map((s, i) => (
      <li data-reveal style={`--delay: ${i * 0.08}s`}>
        <a class="row" href={styleUrl('spark', `/services/#${s.id}`)}>
          <span class="en sp-label">{s.en}</span>
          <span class="title">{s.title}</span>
          <span class="text">{s.summary}</span>
          <span class="arrow" aria-hidden="true">
            <Icon name="arrowRight" size={22} />
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .index {
    border-top: 1px solid var(--sp-line-strong);
  }
  li {
    border-bottom: 1px solid var(--sp-line-strong);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 200px minmax(0, 1.1fr) minmax(0, 1.3fr) 40px;
    align-items: center;
    gap: 32px;
    padding: 34px 8px;
    color: var(--sp-text);
    text-decoration: none;
    transition: background-color 0.3s;
  }
  /* 滑過時的切割線 */
  .row::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, var(--sp-copper), var(--sp-hot));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.6, 0, 0.3, 1);
  }
  .row:hover {
    background: rgb(255 255 255 / 0.025);
  }
  .row:hover::after {
    transform: scaleX(1);
  }
  .en {
    letter-spacing: 0.1em;
  }
  .title {
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    font-weight: 300;
    letter-spacing: 0.06em;
    line-height: 1.3;
    transition: color 0.3s;
  }
  .row:hover .title {
    color: var(--sp-copper-2);
  }
  .text {
    color: var(--sp-text-2);
    font-size: 0.9375rem;
  }
  .arrow {
    justify-self: end;
    color: var(--sp-muted);
    transition:
      color 0.3s,
      transform 0.3s;
  }
  .row:hover .arrow {
    color: var(--sp-copper);
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .row {
      grid-template-columns: minmax(0, 1fr) 32px;
      gap: 6px 16px;
      padding: 26px 4px;
    }
    .en {
      grid-column: 1;
    }
    .title {
      grid-column: 1;
    }
    .text {
      grid-column: 1;
    }
    .arrow {
      grid-column: 2;
      grid-row: 1 / 4;
    }
  }
</style>
