---
/**
 * 公司資料表（關於我們）。內容全部取自 src/data/company.ts。
 */
import { company, address } from '../../data/company';

/** 把 2002-11-18 轉成「民國 91 年 11 月 18 日（2002）」 */
function toRocDate(iso: string): string {
  const [y, m, d] = iso.split('-').map(Number);
  return `民國 ${y - 1911} 年 ${m} 月 ${d} 日（${y}）`;
}

const rows = [
  { label: '公司名稱', value: company.name },
  { label: '統一編號', value: company.taxId, num: true },
  { label: '代表人', value: company.representative },
  { label: '開始營運', value: `民國 ${company.foundedYear - 1911} 年（${company.foundedYear}）` },
  { label: '公司設立', value: toRocDate(company.incorporatedOn) },
  { label: '工廠登記', value: `經濟部工廠登記編號 ${company.factory.registrationNo}（${company.factory.status}）` },
  { label: '產業類別', value: company.factory.industries.join('、') },
  { label: '主要產品', value: company.factory.products.join('；') },
  { label: '營業項目', value: company.businessItems.join('、') },
  { label: '營業地址', value: address },
  { label: '公司登記地址', value: company.registeredAddress },
];
---

<table class="profile">
  <caption class="sp-sr">公司基本資料</caption>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td class:list={{ 'sp-num': row.num }}>{row.value}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .profile {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--sp-line-strong);
  }
  tr {
    border-bottom: 1px solid var(--sp-line);
    transition: background-color 0.2s;
  }
  tr:hover {
    background: rgb(255 255 255 / 0.025);
  }
  th,
  td {
    padding: 18px 16px;
    text-align: left;
    vertical-align: top;
  }
  th {
    width: 11em;
    padding-left: 0;
    font-weight: 400;
    color: var(--sp-muted);
    white-space: nowrap;
  }
  td {
    color: var(--sp-text);
  }

  @media (max-width: 640px) {
    tr {
      display: block;
      padding-block: 14px;
    }
    th,
    td {
      display: block;
      width: auto;
      padding: 0;
    }
    th {
      font-size: 0.875rem;
      margin-bottom: 4px;
    }
  }
</style>
