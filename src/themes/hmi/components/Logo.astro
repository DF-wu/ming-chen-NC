---
/**
 * 標誌：訊號黃方塊中，以線切割路徑描出的「M」（左下圓點是穿線孔）＋公司名稱。
 */
import { company } from '../../../data/company';

interface Props {
  /** 是否顯示第二行英文說明 */
  sub?: boolean;
}

const { sub = true } = Astro.props;
---

<span class="logo">
  <svg class="mark" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true">
    <path d="M0 0h32l8 8v32H0z" fill="var(--hmi-yellow)"></path>
    <path
      d="M11 29V12l9 9.5 9-9.5v17"
      fill="none"
      stroke="var(--hmi-yellow-ink)"
      stroke-width="3"
      stroke-linecap="square"
      stroke-linejoin="miter"></path>
    <circle cx="11" cy="29" r="2.6" fill="var(--hmi-yellow)" stroke="var(--hmi-yellow-ink)" stroke-width="2"></circle>
  </svg>
  <span class="text">
    <span class="name">{company.name}</span>
    {sub && <span class="sub">WIRE EDM · TAINAN · {company.foundedYear}</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--hmi-text);
  }
  .mark {
    flex: none;
  }
  .text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .name {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .sub {
    margin-top: 3px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--hmi-muted);
  }
  @media (max-width: 380px) {
    .name {
      font-size: 0.9375rem;
      letter-spacing: 0.02em;
    }
  }
</style>
