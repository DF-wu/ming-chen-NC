---
/**
 * 內頁頂部：路徑式麵包屑、頁面標題、說明，右側可放讀數（slot="readouts"）。
 * 用法：
 *   <PageHead title="業務項目" en="SERVICES" lead="...">
 *     <dl slot="readouts">...</dl>
 *   </PageHead>
 */
import { styleUrl } from '../../../utils/url';

interface Props {
  title: string;
  /** 英文標籤 */
  en: string;
  lead?: string;
}

const { title, en, lead } = Astro.props;
---

<section class="ph">
  <div class="hmi-wrap ph-inner">
    <div class="ph-main">
      <nav class="crumb mono" aria-label="目前位置">
        <a href={styleUrl('hmi', '/')}>首頁</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>
      <p class="en display" aria-hidden="true">{en}</p>
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
    {
      Astro.slots.has('readouts') && (
        <div class="ph-side">
          <slot name="readouts" />
        </div>
      )
    }
  </div>
</section>

<style>
  .ph {
    background:
      radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.05) 1px, transparent 0) 0 0 / 14px 14px,
      var(--hmi-bg);
    border-bottom: 1px solid var(--hmi-line);
  }
  .ph-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    padding-block: clamp(36px, 5vw, 64px) clamp(32px, 4vw, 52px);
  }
  .ph-inner:not(:has(.ph-side)) {
    grid-template-columns: 1fr;
  }
  .crumb {
    display: flex;
    gap: 10px;
    font-size: 0.8125rem;
    color: var(--hmi-muted);
  }
  .crumb a {
    color: var(--hmi-text-2);
    text-decoration: none;
  }
  .crumb a:hover {
    color: var(--hmi-yellow);
  }
  .crumb [aria-current] {
    color: var(--hmi-yellow);
  }
  .en {
    margin-top: 22px;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--hmi-muted);
  }
  h1 {
    margin-top: 4px;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.15;
  }
  .lead {
    max-width: 36em;
    margin-top: 16px;
    font-size: 1.125rem;
  }

  @media (max-width: 900px) {
    .ph-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
