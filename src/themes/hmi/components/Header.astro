---
/**
 * 頁首：
 * - 上方狀態列（桌機）：工廠狀態、登記編號、統一編號、座標、臺南時間，取自公司資料
 * - 主列：標誌、軟體鍵式主選單（F1–F4）、電話讀數
 * 手機版：選單換到第二行，電話改由底部的 MobileDock 提供。
 */
import Logo from './Logo.astro';
import Glyph from './Glyph.astro';
import { navigation } from '../../../data/site';
import { company, links } from '../../../data/company';
import { styleUrl } from '../../../utils/url';

const strip = (p: string) => p.replace(/\/$/, '');
const current = strip(Astro.url.pathname);
const isActive = (href: string) => {
  const target = strip(styleUrl('hmi', href));
  return href === '/' ? current === target : current.startsWith(target);
};

const lat = company.geo.lat.toFixed(4);
const lng = company.geo.lng.toFixed(4);
---

<div class="status" aria-label="公司狀態">
  <div class="hmi-wrap status-inner">
    <span class="cell"><span class="led"></span>工廠狀態 <b>{company.factory.status}</b></span>
    <span class="cell">工廠登記 <b class="mono">{company.factory.registrationNo}</b></span>
    <span class="cell">統一編號 <b class="mono">{company.taxId}</b></span>
    <span class="cell cell--grow">N {lat}° ／ E {lng}° ・ {company.contact.city}{company.contact.district}</span>
    <span class="cell">臺南時間 <b class="mono" data-hmi-clock>--:--</b></span>
  </div>
</div>

<header class="header">
  <div class="hmi-wrap header-inner">
    <a class="brand" href={styleUrl('hmi', '/')} aria-label={`${company.name}首頁`}>
      <Logo />
    </a>

    <nav class="nav" aria-label="主選單">
      <ul>
        {
          navigation.map((item, i) => (
            <li>
              <a href={styleUrl('hmi', item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                <span class="fk" aria-hidden="true">
                  F{i + 1}
                </span>
                <span class="label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="tel" href={links.tel}>
      <Glyph name="phone" size={18} />
      <span class="tel-label">TEL</span>
      <span class="tel-num mono">{company.contact.phone}</span>
    </a>
  </div>
</header>

<script>
  // 狀態列的臺南時間（每 30 秒更新）
  const el = document.querySelector<HTMLElement>('[data-hmi-clock]');
  if (el) {
    const fmt = new Intl.DateTimeFormat('zh-TW', {
      timeZone: 'Asia/Taipei',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const tick = () => (el.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 30_000);
  }
</script>

<style>
  /* 狀態列 */
  .status {
    background: var(--hmi-screen);
    border-bottom: 1px solid var(--hmi-line-soft);
    font-size: 0.8125rem;
    color: var(--hmi-muted);
  }
  .status-inner {
    display: flex;
    align-items: stretch;
  }
  .cell {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-left: 1px solid var(--hmi-line-soft);
    white-space: nowrap;
  }
  .cell:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .cell:last-child {
    padding-right: 0;
  }
  .cell b {
    font-weight: 500;
    color: var(--hmi-text);
  }
  .cell--grow {
    flex: 1;
    justify-content: flex-end;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  /* 主列 */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(19 21 23 / 0.96);
    border-bottom: 1px solid var(--hmi-line);
  }
  .header-inner {
    display: flex;
    align-items: stretch;
    gap: 24px;
    min-height: var(--header-h);
  }
  .brand {
    display: flex;
    align-items: center;
    margin-right: auto;
    text-decoration: none;
  }

  .nav ul {
    display: flex;
    height: 100%;
  }
  .nav li {
    display: flex;
  }
  .nav a {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 108px;
    padding: 8px 18px;
    border-left: 1px solid var(--hmi-line-soft);
    color: var(--hmi-text-2);
    text-decoration: none;
    transition:
      background-color 0.15s,
      color 0.15s;
  }
  .nav li:last-child a {
    border-right: 1px solid var(--hmi-line-soft);
  }
  .nav a:hover {
    background: var(--hmi-panel);
    color: var(--hmi-text);
  }
  .fk {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--hmi-muted);
  }
  .label {
    margin-top: 4px;
    font-weight: 500;
    line-height: 1.3;
  }
  .nav a[aria-current='page'] {
    background: var(--hmi-panel);
    color: var(--hmi-text);
  }
  .nav a[aria-current='page'] .fk {
    color: var(--hmi-yellow);
  }
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 3px;
    background: var(--hmi-yellow);
  }

  .tel {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-block: 12px;
    padding: 0 18px;
    background: var(--hmi-yellow);
    color: var(--hmi-yellow-ink);
    text-decoration: none;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
    transition: background-color 0.15s;
  }
  .tel:hover {
    background: var(--hmi-yellow-hover);
  }
  .tel-label {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .tel-num {
    font-size: 1.0625rem;
    font-weight: 600;
  }

  @media (max-width: 1180px) {
    .cell--grow {
      display: none;
    }
    .nav a {
      min-width: 0;
      padding-inline: 14px;
    }
    .tel-label {
      display: none;
    }
  }

  /* 手機：狀態列精簡、選單換行、電話交給底部聯絡列 */
  @media (max-width: 860px) {
    .status .cell:not(:first-child) {
      display: none;
    }
    .header {
      position: relative;
    }
    .header-inner {
      flex-wrap: wrap;
      gap: 0;
      min-height: 0;
    }
    .brand {
      padding-block: 12px;
    }
    .tel {
      display: none;
    }
    .nav {
      width: calc(100% + var(--gutter) * 2);
      margin-inline: calc(var(--gutter) * -1);
      border-top: 1px solid var(--hmi-line-soft);
    }
    .nav ul {
      width: 100%;
    }
    .nav li {
      flex: 1;
    }
    .nav a {
      flex: 1;
      align-items: center;
      padding: 8px 2px 10px;
      border-right: 0;
      font-size: 0.9375rem;
    }
    .nav li:first-child a {
      border-left: 0;
    }
    .nav li:last-child a {
      border-right: 0;
    }
  }
</style>
