---
/**
 * 頁尾：完整聯絡資訊、公司登記資料、網站導覽。
 */
import Logo from './Logo.astro';
import { navigation, site } from '../../../data/site';
import { company, fullAddress, links } from '../../../data/company';
import { styleUrl } from '../../../utils/url';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="hmi-wrap grid">
    <div class="brand">
      <Logo />
      <p>{site.tagline}</p>
    </div>

    <dl class="block">
      <dt class="block-title">聯絡</dt>
      <dd>
        <ul class="rows">
          <li><span>電話</span><a class="mono" href={links.tel}>{company.contact.phone}</a></li>
          <li><span>傳真</span><b class="mono">{company.contact.fax}</b></li>
          <li><span>Email</span><a href={links.mailto}>{company.contact.email}</a></li>
          <li><span>地址</span><a href={links.map} target="_blank" rel="noopener">{fullAddress}</a></li>
          <li><span>營業時間</span><b>{company.contact.hours}</b></li>
        </ul>
      </dd>
    </dl>

    <dl class="block">
      <dt class="block-title">公司</dt>
      <dd>
        <ul class="rows">
          <li><span>統一編號</span><b class="mono">{company.taxId}</b></li>
          <li><span>工廠登記</span><b class="mono">{company.factory.registrationNo}</b></li>
          <li><span>代表人</span><b>{company.representative}</b></li>
        </ul>
      </dd>
    </dl>

    <nav class="block" aria-label="頁尾選單">
      <p class="block-title">頁面</p>
      <ul class="pages">
        {
          navigation.map((item) => (
            <li>
              <a href={styleUrl('hmi', item.href)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="hmi-wrap bottom">
    <p>© {year} {company.name}</p>
    <p class="mono">{company.contact.city}{company.contact.district} ・ CNC WIRE EDM</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--hmi-screen);
    border-top: 1px solid var(--hmi-line);
    font-size: 0.9375rem;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.2fr 1.7fr 1fr 0.6fr;
    gap: 40px;
    padding-block: 56px 44px;
  }
  .brand p {
    margin-top: 16px;
    color: var(--hmi-muted);
  }
  .block-title {
    margin-bottom: 14px;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--hmi-yellow);
  }
  .rows li {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 12px;
    padding-block: 5px;
    border-bottom: 1px solid var(--hmi-line-soft);
  }
  .rows li:last-child {
    border-bottom: 0;
  }
  .rows span {
    color: var(--hmi-muted);
    font-size: 0.875rem;
  }
  .rows b {
    font-weight: 400;
    color: var(--hmi-text-2);
  }
  .footer a {
    color: var(--hmi-text);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .footer a:hover {
    color: var(--hmi-yellow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pages li {
    padding-block: 5px;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    padding-block: 18px;
    border-top: 1px solid var(--hmi-line-soft);
    font-size: 0.8125rem;
    color: var(--hmi-muted);
  }

  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 860px) {
    /* 手機底部聯絡列的空間 */
    .footer {
      padding-bottom: calc(64px + env(safe-area-inset-bottom, 0px));
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
