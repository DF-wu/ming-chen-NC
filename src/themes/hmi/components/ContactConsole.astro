---
/**
 * 聯絡面板：大號電話讀數＋傳真、Email、地址、營業時間，下方是操作鍵。
 * 放在首頁、業務項目、關於我們的底部；聯絡頁用 full 版本（多顯示統一編號）。
 */
import Glyph from './Glyph.astro';
import { company, fullAddress, links } from '../../../data/company';
import { styleUrl } from '../../../utils/url';

interface Props {
  /** 聯絡頁使用：顯示統一編號、不顯示「聯絡頁」按鍵 */
  full?: boolean;
  /** 標題層級：聯絡頁內為 h2，其他頁面底部亦為 h2 */
  title?: string;
}

const { full = false, title = '聯絡' } = Astro.props;
---

<div class="hmi-panel console reveal">
  <header class="hmi-titlebar">
    <h2>{title}</h2>
    <span class="tb-en">CONTACT</span>
    <span class="tb-right"><span class="led"></span> 歡迎洽詢</span>
  </header>

  <div class="body">
    <a class="phone" href={links.tel}>
      <span class="phone-label">電話</span>
      <span class="phone-num display">{company.contact.phone}</span>
      <span class="phone-hint">點擊即可撥打 ・ 洽詢加工、報價</span>
    </a>

    <dl class="rows">
      <div class="row">
        <dt><Glyph name="fax" size={18} />傳真</dt>
        <dd class="mono">{company.contact.fax}</dd>
      </div>
      <div class="row">
        <dt><Glyph name="mail" size={18} />Email</dt>
        <dd><a href={links.mailto}>{company.contact.email}</a></dd>
      </div>
      <div class="row">
        <dt><Glyph name="pin" size={18} />地址</dt>
        <dd>{fullAddress}</dd>
      </div>
      <div class="row">
        <dt><Glyph name="clock" size={18} />營業時間</dt>
        <dd>{company.contact.hours}</dd>
      </div>
      {
        full && (
          <div class="row">
            <dt>
              <Glyph name="id" size={18} />
              統一編號
            </dt>
            <dd class="mono">{company.taxId}</dd>
          </div>
        )
      }
    </dl>
  </div>

  <nav class="keys" aria-label="聯絡操作">
    <a class="hmi-key hmi-key--primary" href={links.tel}><Glyph name="phone" />撥打電話</a>
    <a class="hmi-key" href={links.mailto}><Glyph name="mail" />寄送 Email</a>
    <a class="hmi-key" href={links.directions} target="_blank" rel="noopener"><Glyph name="route" />規劃路線</a>
    {
      !full && (
        <a class="hmi-key" href={styleUrl('hmi', '/contact/')}>
          聯絡頁與地圖
          <Glyph name="arrow" />
        </a>
      )
    }
  </nav>
</div>

<style>
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
  }

  .phone {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: clamp(24px, 3.5vw, 44px);
    background: var(--hmi-screen);
    border-right: 1px solid var(--hmi-line);
    text-decoration: none;
    transition: background-color 0.15s;
  }
  .phone:hover {
    background: #101315;
  }
  .phone-label {
    font-size: 0.875rem;
    color: var(--hmi-muted);
  }
  .phone-num {
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: 600;
    line-height: 1.05;
    color: var(--hmi-yellow);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .phone-hint {
    font-size: 0.875rem;
    color: var(--hmi-text-2);
  }

  .rows {
    padding: 8px clamp(18px, 2.6vw, 32px);
  }
  .row {
    display: grid;
    grid-template-columns: 116px 1fr;
    gap: 12px;
    padding-block: 14px;
    border-bottom: 1px solid var(--hmi-line-soft);
  }
  .row:last-child {
    border-bottom: 0;
  }
  .row dt {
    display: flex;
    align-items: center;
    gap: 8px;
    align-self: start;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--hmi-muted);
  }
  .row dt :global(svg) {
    color: var(--hmi-yellow);
  }
  .row dd {
    color: var(--hmi-text);
    overflow-wrap: anywhere;
  }
  .row dd a {
    color: var(--hmi-text);
    text-underline-offset: 3px;
  }
  .row dd a:hover {
    color: var(--hmi-yellow);
  }

  .keys {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 1px;
    background: var(--hmi-line);
    border-top: 1px solid var(--hmi-line);
  }
  .keys .hmi-key {
    justify-content: center;
    min-height: 56px;
    border: 0;
    background: var(--hmi-panel);
  }
  .keys .hmi-key:hover {
    background: var(--hmi-panel-2);
    box-shadow: inset 0 -3px 0 var(--hmi-yellow);
  }
  .keys .hmi-key--primary {
    background: var(--hmi-yellow);
  }
  .keys .hmi-key--primary:hover {
    background: var(--hmi-yellow-hover);
    box-shadow: none;
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
    }
    .phone {
      border-right: 0;
      border-bottom: 1px solid var(--hmi-line);
    }
    .keys {
      grid-auto-flow: row;
      grid-template-columns: 1fr 1fr;
    }
    /* 奇數個按鍵時，最後一個跨滿整列 */
    .keys .hmi-key:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .phone-num {
      font-size: 2.75rem;
    }
  }
</style>
