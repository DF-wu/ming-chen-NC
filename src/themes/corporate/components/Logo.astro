---
/**
 * 公司標誌：右上倒角的藍色方塊，內有一道線切割路徑（起點為穿線孔）＋公司名稱。
 * inverse：用在深色背景上。
 */
import { company } from '../../../data/company';

interface Props {
  inverse?: boolean;
}

const { inverse = false } = Astro.props;
---

<span class:list={['logo', { 'logo--inverse': inverse }]}>
  <svg class="mark" viewBox="0 0 44 44" width="44" height="44" aria-hidden="true">
    <path d="M0 0H34L44 10V44H0Z" class="mark-bg"></path>
    <path d="M12 32V13H31V24H22V32Z" class="mark-cut"></path>
    <circle cx="12" cy="32" r="2.6" class="mark-hole"></circle>
  </svg>
  <span class="words">
    <span class="name">{company.name}</span>
    <span class="tag">CNC 線切割・模具零件加工</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--ink);
  }
  .mark {
    flex: none;
  }
  .mark-bg {
    fill: var(--blue);
  }
  .mark-cut {
    fill: none;
    stroke: var(--white);
    stroke-width: 2.6;
    stroke-linejoin: miter;
  }
  .mark-hole {
    fill: var(--blue);
    stroke: var(--white);
    stroke-width: 2;
  }
  .words {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }
  .name {
    font-size: 1.125rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .tag {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .logo--inverse {
    color: var(--white);
  }
  .logo--inverse .tag {
    color: var(--steel);
  }

  @media (max-width: 400px) {
    .name {
      font-size: 1rem;
      letter-spacing: 0.04em;
    }
    .mark {
      width: 38px;
      height: 38px;
    }
  }
</style>
