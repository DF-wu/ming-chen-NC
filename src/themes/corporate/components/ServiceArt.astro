---
/**
 * 業務項目的技術線稿（純 SVG）。藍色線條為加工部位，進入畫面時會依序描繪
 * （由外層加上 data-draw 觸發，見 theme.css）。
 * 用法：<ServiceArt id="wire-edm" tone="dark" />
 */
import { gearPath } from '../../../utils/gear';

interface Props {
  /** 業務 id：wire-edm、mold、jig、parts */
  id: string;
  /** 深色背景用 dark */
  tone?: 'light' | 'dark';
}

const { id, tone = 'light' } = Astro.props;

// ── 線切割：等角視圖的工件，上下導線頭與穿過工件的電極線 ──
const O = { x: 250, y: 92 };
const iso = (x: number, y: number, z = 0) =>
  `${(O.x + 0.866 * (x - y)).toFixed(1)} ${(O.y + 0.5 * (x + y) - z).toFixed(1)}`;
const plate = { w: 200, d: 140, t: 26 };
const plateTop = `M ${iso(0, 0)} L ${iso(plate.w, 0)} L ${iso(plate.w, plate.d)} L ${iso(0, plate.d)} Z`;
const plateSides = `M ${iso(0, plate.d)} L ${iso(0, plate.d, -plate.t)} L ${iso(plate.w, plate.d, -plate.t)} L ${iso(plate.w, 0, -plate.t)} L ${iso(plate.w, 0)} M ${iso(plate.w, plate.d)} L ${iso(plate.w, plate.d, -plate.t)}`;
// 工件上的切割輪廓（沖頭外形），從穿線孔進刀
const contour = [
  [70, 70],
  [70, 40],
  [150, 40],
  [150, 58],
  [128, 58],
  [128, 82],
  [150, 82],
  [150, 100],
  [70, 100],
  [70, 70],
];
const cut = `M ${iso(40, 70)} L ${contour.map(([x, y]) => iso(x, y)).join(' L ')}`;
const holeAt = iso(40, 70).split(' ').map(Number);
const wireX = O.x; // 電極線位於 (70, 70)，等角投影後 x = O.x
const wireTop = O.y + 70;

// ── 精密零件：齒輪正視圖 ──
const smallGear = gearPath({ cx: 388, cy: 168, outer: 70, root: 59, teeth: 16 });
---

<svg class:list={['art', `art--${tone}`]} viewBox="0 0 480 330" aria-hidden="true">
  {
    id === 'wire-edm' && (
      <g>
        {/* 上導線頭 */}
        <path d={`M ${wireX - 36} 14 H ${wireX + 36} V 50 L ${wireX + 26} 60 H ${wireX - 26} L ${wireX - 36} 50 Z`} class="ln" />
        <path d={`M ${wireX - 12} 60 H ${wireX + 12} V 72 H ${wireX - 12} Z`} class="ln" />
        {/* 工件 */}
        <path d={plateTop} class="ln fill" />
        <path d={plateSides} class="ln" />
        {/* 切割輪廓 */}
        <path d={cut} class="ac draw" pathLength="1" />
        <circle cx={holeAt[0]} cy={holeAt[1]} r="4" class="ac-hole" />
        {/* 電極線：工件上方、內部（虛線）、下方 */}
        <path d={`M ${wireX} 72 V ${wireTop}`} class="wire" />
        <path d={`M ${wireX} ${wireTop} V 262`} class="wire hidden" />
        <path d={`M ${wireX} 262 V 280`} class="wire" />
        {/* 放電火花 */}
        <path d={`M ${wireX - 6} ${wireTop - 8} l -8 -6 M ${wireX + 6} ${wireTop - 8} l 8 -6 M ${wireX} ${wireTop - 10} v -9`} class="spark" />
        {/* 下導線頭 */}
        <path d={`M ${wireX - 12} 280 H ${wireX + 12} V 290 H ${wireX - 12} Z`} class="ln" />
        <path d={`M ${wireX - 26} 290 H ${wireX + 26} L ${wireX + 36} 300 V 324 H ${wireX - 36} V 300 Z`} class="ln" />
      </g>
    )
  }

  {
    id === 'mold' && (
      <g>
        <path d="M240 12 V 318" class="center" />
        {/* 上模座、導套 */}
        <path d="M90 28 H390 V68 H90 Z" class="ln fill" />
        <path d="M112 68 V82 H130 V68 M350 68 V82 H368 V68" class="ln" />
        {/* 沖頭 */}
        <path d="M204 68 V104 H220 V150 H260 V104 H276 V68" class="ac draw" pathLength="1" />
        {/* 料帶 */}
        <path d="M54 192 H426 M54 200 H426" class="ln thin" />
        {/* 導柱 */}
        <path d="M115 248 V128 H127 V248 M353 248 V128 H365 V248" class="ln" />
        {/* 下模板與模穴 */}
        <path d="M90 248 H220 V276 H260 V248 H390 V300 H90 Z" class="ln fill" />
        <path d="M220 248 V276 H260 V248" class="ac draw" pathLength="1" style="--delay: 0.6s" />
        {/* 合模方向 */}
        <path d="M440 92 V 156 M432 144 L440 158 L448 144" class="ln" />
      </g>
    )
  }

  {
    id === 'jig' && (
      <g>
        {/* 底板 */}
        <path d="M40 252 H440 V284 H40 Z" class="ln fill" />
        <path d="M70 284 V300 M410 284 V300" class="ln thin" />
        {/* 定位塊 */}
        <path d="M86 252 V172 H144 V252" class="ln" />
        {/* 工件 */}
        <path d="M144 252 V204 H324 V252" class="ac draw" pathLength="1" />
        {/* 側推夾鉗與螺桿 */}
        <path d="M324 252 V194 H364 V252" class="ln" />
        <path d="M364 216 H430 M364 228 H430" class="ln" />
        <circle cx="442" cy="222" r="12" class="ln" />
        {/* 上壓式快速夾鉗 */}
        <path d="M54 252 V110 H74 V252" class="ln" />
        <path d="M64 120 L234 150 V188" class="ln" />
        <path d="M220 188 H248 V204 H220 Z" class="ln fill" />
        <path d="M64 120 L36 72" class="ln" />
        <circle cx="64" cy="120" r="6" class="ln" />
      </g>
    )
  }

  {
    id === 'parts' && (
      <g>
        <path d="M18 168 H312 M388 82 V254 M302 168 H474" class="center" />
        {/* 階梯軸 */}
        <path d="M30 152 L36 146 H82 V136 H190 V122 H226 V142 H292 L298 148 V188 L292 194 H226 V214 H190 V200 H82 V190 H36 L30 184 Z" class="ln fill" />
        <path d="M82 136 V200 M190 122 V214 M226 142 V194" class="ln thin" />
        {/* 鍵槽 */}
        <path d="M112 136 V146 H162 V136" class="ac draw" pathLength="1" />
        {/* 齒輪 */}
        <path d={smallGear} class="ac draw" pathLength="1" style="--delay: 0.5s" />
        <circle cx="388" cy="168" r="44" class="ln thin" />
        <path d="M382 151 V143 H394 V151 A18 18 0 1 1 382 151 Z" class="ln" />
      </g>
    )
  }
</svg>

<style>
  .art {
    width: 100%;
    height: auto;
    --art-line: #4a5764;
    --art-fill: #f7f9fa;
    --art-accent: var(--blue);
    --art-center: #a2adb8;
  }
  .art--dark {
    --art-line: #9fb0c1;
    --art-fill: rgb(255 255 255 / 0.04);
    --art-accent: #8cc0ff;
    --art-center: #4f6378;
  }
  .ln {
    fill: none;
    stroke: var(--art-line);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .ln.fill {
    fill: var(--art-fill);
  }
  .ln.thin {
    stroke-width: 1;
  }
  .ac {
    fill: none;
    stroke: var(--art-accent);
    stroke-width: 2.4;
    stroke-linejoin: round;
  }
  .ac-hole {
    fill: none;
    stroke: var(--art-accent);
    stroke-width: 1.6;
  }
  .wire {
    stroke: var(--art-accent);
    stroke-width: 1.6;
  }
  .wire.hidden {
    stroke-dasharray: 4 4;
    opacity: 0.7;
  }
  .spark {
    fill: none;
    stroke: var(--art-accent);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .center {
    fill: none;
    stroke: var(--art-center);
    stroke-width: 1;
    stroke-dasharray: 16 4 3 4;
  }
</style>
