---
/**
 * 業務項目頁的單一服務：左側技術線稿、右側說明、服務內容與規格表。
 */
import ServiceArt from './ServiceArt.astro';
import type { Service } from '../../../data/services';
import { specRows } from '../content';

interface Props {
  service: Service;
  index: number;
}

const { service, index } = Astro.props;
const rows = specRows(service);
---

<article class="svc" id={service.id}>
  <div class="c-container c-grid">
    <header class="svc-head">
      <p class="svc-en c-display">{service.en}</p>
      <h2>{service.title}</h2>
    </header>

    <figure class="svc-art" data-draw>
      <ServiceArt id={service.id} tone={index === 0 ? 'dark' : 'light'} />
    </figure>

    <div class="svc-body" data-reveal>
      <p class="svc-desc">{service.description}</p>

      <h3>服務內容</h3>
      <ul class="points">
        {service.points.map((p) => <li>{p}</li>)}
      </ul>

      <table class="c-table spec">
        <caption class="visually-hidden">{service.title} 規格表</caption>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td>{row.value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      {service.materials && <p class="note">實際可加工的材質、尺寸與精度，歡迎來電洽詢。</p>}
    </div>
  </div>
</article>

<style>
  .svc {
    padding-block: clamp(56px, 7vw, 96px);
    border-bottom: 1px solid var(--line);
  }
  .svc:nth-of-type(even) {
    background: #f7f9fa;
  }
  .svc-head {
    grid-column: 1 / -1;
    margin-bottom: 32px;
  }
  .svc-en {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--blue);
  }
  h2 {
    font-size: clamp(1.875rem, 3.6vw, 2.75rem);
    font-weight: 900;
    letter-spacing: 0.06em;
  }

  .svc-art {
    grid-column: 1 / span 5;
    align-self: start;
    padding: clamp(16px, 2.4vw, 32px);
    background: var(--band);
    clip-path: polygon(0 0, calc(100% - 32px) 0, 100% 32px, 100% 100%, 0 100%);
  }
  .svc:first-of-type .svc-art {
    background-color: var(--navy);
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .svc-body {
    grid-column: 7 / span 6;
  }
  .svc-desc {
    font-size: 1.0625rem;
    color: var(--ink-2);
  }
  h3 {
    margin: 32px 0 14px;
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .points {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 28px;
    margin-bottom: 36px;
  }
  .points li {
    position: relative;
    padding-left: 18px;
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 8px;
    height: 8px;
    background: var(--blue);
  }
  .note {
    margin-top: 14px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .svc-art,
    .svc-body {
      grid-column: 1 / -1;
    }
    .svc-art {
      margin-bottom: 32px;
    }
  }
  @media (max-width: 560px) {
    .points {
      grid-template-columns: 1fr;
    }
  }
</style>
