---
/**
 * 內頁頂部色帶：麵包屑、大標題＋英文、說明。右側有淡淡的齒輪輪廓裝飾。
 * 用法：<PageHeader title="業務項目" en="Services" lead="..." />
 */
import { gearPath } from '../../../utils/gear';
import { styleUrl } from '../../../utils/url';

interface Props {
  title: string;
  en: string;
  lead?: string;
}

const { title, en, lead } = Astro.props;
const gear = gearPath({ cx: 300, cy: 300, outer: 260, root: 232, teeth: 28 });
---

<section class="ph">
  <svg class="ph-art" viewBox="0 0 600 600" aria-hidden="true">
    <path d={gear} />
    <circle cx="300" cy="300" r="150" />
    <circle cx="300" cy="300" r="70" />
    <path d="M300 20V580M20 300H580" class="center" />
  </svg>
  <div class="c-container ph-inner">
    <nav class="crumb" aria-label="目前位置">
      <ol>
        <li><a href={styleUrl('corporate', '/')}>首頁</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>
    <h1>
      {title}
      <span class="en c-display">{en}</span>
    </h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>

<style>
  .ph {
    position: relative;
    overflow: hidden;
    background: var(--band);
    border-bottom: 1px solid var(--line);
  }
  .ph-art {
    position: absolute;
    right: -120px;
    top: 50%;
    width: 560px;
    transform: translateY(-50%);
    fill: none;
    stroke: #c9d1d9;
    stroke-width: 1.2;
  }
  .ph-art .center {
    stroke-dasharray: 18 6 3 6;
  }
  .ph-inner {
    position: relative;
    padding-block: clamp(40px, 6vw, 72px) clamp(48px, 6vw, 80px);
  }
  .crumb ol {
    display: flex;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .crumb li + li::before {
    content: '›';
    margin-right: 8px;
  }
  .crumb a {
    text-decoration: none;
  }
  .crumb a:hover {
    color: var(--blue);
    text-decoration: underline;
  }
  h1 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 22px;
    margin-top: 18px;
    font-size: clamp(2.25rem, 5.4vw, 3.75rem);
    font-weight: 900;
    letter-spacing: 0.08em;
  }
  .en {
    font-size: 0.5em;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--blue);
  }
  .lead {
    max-width: 38em;
    margin-top: 16px;
    font-size: 1.125rem;
    color: var(--ink-2);
  }
  @media (max-width: 860px) {
    .ph-art {
      width: 380px;
      right: -170px;
      opacity: 0.6;
    }
  }
</style>
