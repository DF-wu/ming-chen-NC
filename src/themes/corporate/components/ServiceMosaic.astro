---
/**
 * 首頁業務入口：大小磚格拼貼（參考 DMG MORI）。
 * 核心業務「線切割」為深色大磚，其餘三項為淺灰磚。整塊磚都可點擊。
 */
import Heading from './Heading.astro';
import ServiceArt from './ServiceArt.astro';
import Icon from '../../../components/Icon.astro';
import { services } from '../../../data/services';
import { styleUrl } from '../../../utils/url';
import { serviceMeta } from '../content';

const [main, ...rest] = services;
---

<section class="c-section">
  <div class="c-container">
    <Heading title="業務項目" en="Services" link={{ href: styleUrl('corporate', '/services/'), label: '查看全部業務' }} />

    <div class="mosaic">
      <a class="tile tile--main" href={styleUrl('corporate', `/services/#${main.id}`)} data-reveal>
        <div class="tile-art" data-draw>
          <ServiceArt id={main.id} tone="dark" />
        </div>
        <div class="tile-text">
          <p class="tile-en c-display">{main.en}</p>
          <h3>{main.title}</h3>
          <p class="tile-summary">{main.summary}</p>
          <ul class="tile-points">
            {main.points.map((p) => <li>{p}</li>)}
          </ul>
        </div>
        <span class="tile-go" aria-hidden="true"><Icon name="arrowRight" /></span>
      </a>

      {
        rest.map((s, i) => (
          <a class:list={['tile', `tile--${i}`]} href={styleUrl('corporate', `/services/#${s.id}`)} data-reveal style={`--delay: ${0.1 * (i + 1)}s`}>
            <div class="tile-art" data-draw>
              <ServiceArt id={s.id} />
            </div>
            <div class="tile-text">
              <p class="tile-en c-display">{s.en}</p>
              <h3>{s.title}</h3>
              <p class="tile-summary">{s.summary}</p>
              <p class="tile-scope">
                <span>適用</span>
                {serviceMeta[s.id]?.scope}
              </p>
            </div>
            <span class="tile-go" aria-hidden="true">
              <Icon name="arrowRight" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(300px, auto);
    gap: 16px;
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    padding: 28px 28px 32px;
    background: var(--band);
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    transition: background-color 0.3s;
  }
  .tile:hover {
    background: #e3e8ed;
  }
  .tile--main {
    grid-column: span 7;
    grid-row: span 2;
    background-color: var(--navy);
    background-image:
      linear-gradient(rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 32px 32px;
    color: var(--white);
    clip-path: polygon(0 0, calc(100% - 40px) 0, 100% 40px, 100% 100%, 0 100%);
  }
  .tile--main:hover {
    background-color: #102236;
  }
  /* 右側上下兩塊、第三排全寬 */
  .tile--0 {
    grid-column: 8 / span 5;
  }
  .tile--1 {
    grid-column: 8 / span 5;
  }
  .tile--2 {
    grid-column: 1 / span 12;
  }

  .tile-art {
    width: min(100%, 360px);
    align-self: flex-end;
  }
  .tile--main .tile-art {
    width: min(100%, 600px);
    align-self: center;
    margin-block: auto;
  }

  .tile-en {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--blue);
  }
  .tile--main .tile-en {
    color: var(--blue-light);
  }
  h3 {
    font-size: clamp(1.375rem, 2vw, 1.625rem);
    font-weight: 900;
    letter-spacing: 0.06em;
  }
  .tile--main h3 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
  }
  .tile-summary {
    margin-top: 8px;
    color: var(--ink-2);
  }
  .tile--main .tile-summary {
    max-width: 30em;
    color: #c6d1dc;
  }
  .tile-points {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px 20px;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid rgb(255 255 255 / 0.16);
    font-size: 0.9375rem;
    color: #dbe3ea;
  }
  .tile-points li {
    position: relative;
    padding-left: 16px;
  }
  .tile-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 7px;
    height: 7px;
    background: var(--blue-light);
  }
  .tile-scope {
    display: flex;
    gap: 10px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .tile-scope span {
    flex: none;
    font-weight: 700;
    color: var(--blue);
  }

  .tile-go {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    background: var(--blue);
    color: var(--white);
    clip-path: polygon(14px 0, 100% 0, 100% 100%, 0 100%, 0 14px);
    transition: width 0.3s var(--ease);
  }
  .tile:hover .tile-go {
    width: 64px;
  }
  .tile-go :global(svg) {
    width: 22px;
    height: 22px;
  }

  /* 第三塊（全寬）改為左右排列 */
  .tile--2 {
    flex-direction: row-reverse;
    align-items: center;
  }
  .tile--2 .tile-art {
    width: min(42%, 380px);
    align-self: center;
  }
  .tile--2 .tile-text {
    max-width: 34em;
  }

  @media (max-width: 1000px) {
    .tile--main,
    .tile--0,
    .tile--1,
    .tile--2 {
      grid-column: 1 / -1;
      grid-row: auto;
    }
  }
  @media (max-width: 640px) {
    .mosaic {
      grid-auto-rows: auto;
    }
    .tile {
      padding: 24px 20px 64px;
    }
    .tile--2 {
      flex-direction: column;
      align-items: stretch;
    }
    .tile--2 .tile-art {
      width: min(100%, 360px);
      align-self: flex-end;
    }
    .tile-points {
      grid-template-columns: 1fr;
    }
    .tile--main {
      clip-path: polygon(0 0, calc(100% - 28px) 0, 100% 28px, 100% 100%, 0 100%);
    }
  }
</style>
