---
/**
 * 頁首：印章標誌與公司名、主選單、電話（附受理說明）。
 * 手機版：選單換到第二行，電話改由底部快速聯絡列提供。
 */
import Seal from './Seal.astro';
import { navigation } from '../../../data/site';
import { company, links } from '../../../data/company';
import { styleUrl } from '../../../utils/url';

const strip = (p: string) => p.replace(/\/$/, '');
const current = strip(Astro.url.pathname);
const isActive = (href: string) => {
  const target = strip(styleUrl('monozukuri', href));
  return href === '/' ? current === target : current.startsWith(target);
};
---

<header class="hd">
  <div class="wrap hd-in">
    <a class="brand" href={styleUrl('monozukuri', '/')} aria-label={`${company.name}首頁`}>
      <Seal size={38} />
      <span class="brand-name">{company.name}</span>
    </a>

    <nav class="nav" aria-label="主選單">
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a href={styleUrl('monozukuri', item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="tel" href={links.tel}>
      <span class="tel-label">電話洽詢</span>
      <span class="tel-no num">{company.contact.phone}</span>
    </a>
  </div>
</header>

<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(251 250 247 / 0.96);
    border-bottom: 1px solid var(--line);
  }
  .hd-in {
    display: flex;
    align-items: center;
    gap: clamp(20px, 3vw, 48px);
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-right: auto;
    text-decoration: none;
  }
  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .nav ul {
    display: flex;
    gap: clamp(16px, 2.4vw, 36px);
  }
  .nav a {
    position: relative;
    display: block;
    padding-block: 8px;
    font-size: 0.9375rem;
    letter-spacing: 0.16em;
    text-decoration: none;
    color: var(--ink-2);
    transition: color 0.25s;
  }
  .nav a:hover {
    color: var(--ink);
  }
  .nav a[aria-current='page'] {
    color: var(--ink);
  }
  /* 目前頁面：下方一個朱色小方點 */
  .nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    background: var(--shu);
  }

  .tel {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-left: clamp(20px, 2.4vw, 32px);
    border-left: 1px solid var(--line);
    line-height: 1.3;
    text-decoration: none;
  }
  .tel-label {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    color: var(--muted);
  }
  .tel-no {
    font-size: 1.25rem;
    font-weight: 500;
    transition: color 0.25s;
  }
  .tel:hover .tel-no {
    color: var(--shu);
  }

  @media (max-width: 1080px) {
    .brand-name {
      font-size: 0.9375rem;
      letter-spacing: 0.08em;
    }
  }

  /* 手機：頁首不固定，選單換到第二行，電話交給底部聯絡列 */
  @media (max-width: 820px) {
    .hd {
      position: relative;
    }
    .hd-in {
      flex-wrap: wrap;
      gap: 0;
      min-height: 0;
      padding-top: 14px;
    }
    .tel {
      display: none;
    }
    .nav {
      width: 100%;
      margin-top: 12px;
      border-top: 1px solid var(--line);
    }
    .nav ul {
      justify-content: space-between;
      gap: 0;
    }
    .nav a {
      padding: 12px 2px 13px;
      font-size: 0.9375rem;
      letter-spacing: 0.08em;
    }
  }
</style>
