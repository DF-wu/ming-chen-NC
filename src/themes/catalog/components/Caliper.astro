---
/**
 * 首頁招牌動畫：數位游標卡尺夾住一塊線切割加工的模具入子，
 * 讀數從張開的位置滾動到量測值，接觸後標出尺寸線。
 * 沒有 JavaScript 或偏好減少動態時，直接顯示量測完成的畫面。
 * 圖中數值皆為裝飾用，不代表加工精度。
 */
interface Props {
  caption: string;
}

const { caption } = Astro.props;

const K = 5; // 1 mm 在圖上的長度（viewBox 單位）
const X0 = 96; // 固定量爪的量測面（0 點）
const MEASURE = 30; // 量測值（mm）
const OPEN = 60; // 動畫開始時的張開量（mm）
const XS = X0 + MEASURE * K; // 活動量爪的量測面
const BEAM = { x: 40, y: 100, w: 660, h: 34 };

// 主尺刻度：每 1 mm 短線、5 mm 中線、10 mm 長線並標數字（cm）
const ticks: string[] = [];
const numbers: { x: number; text: string }[] = [];
for (let mm = 0; mm <= 118; mm++) {
  const x = X0 + mm * K;
  const len = mm % 10 === 0 ? 15 : mm % 5 === 0 ? 10 : 6;
  ticks.push(`M ${x} ${BEAM.y} v ${len}`);
  if (mm % 10 === 0) numbers.push({ x, text: String(mm / 10) });
}

const pts = (list: number[][]) => list.map((p) => p.join(',')).join(' ');
---

<figure class="cal" data-caliper data-open={OPEN} data-measure={MEASURE} data-k={K}>
  <div class="cal-view">
    <svg viewBox="0 0 720 300" role="img" aria-label="游標卡尺量測線切割模具零件的示意插圖">
      <defs>
        <linearGradient id="cal-steel" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f6f7f8"></stop>
          <stop offset="0.55" stop-color="#d6dce1"></stop>
          <stop offset="1" stop-color="#eceff2"></stop>
        </linearGradient>
      </defs>

      <!-- 固定量爪：下方外徑量爪的量測面朝右；上方內徑量爪的量測面朝左 -->
      <polygon class="steel" points={pts([[44, 134], [X0, 134], [X0, 252], [X0 - 6, 262], [X0 - 16, 262], [44, 176]])}></polygon>
      <polygon class="steel" points={pts([[X0, 100], [X0 + 30, 100], [X0 + 5, 50], [X0, 58]])}></polygon>

      <!-- 主尺與刻度 -->
      <rect class="steel" x={BEAM.x} y={BEAM.y} width={BEAM.w} height={BEAM.h}></rect>
      <path class="tick" d={ticks.join(' ')}></path>
      {
        numbers.map((n) => (
          <text class="num" x={n.x + 2} y={BEAM.y + 28}>
            {n.text}
          </text>
        ))
      }

      <!-- 工件：線切割加工的模具入子（藍線為加工輪廓） -->
      <g class="part">
        <rect class="part-edge" x={X0} y="150" width={MEASURE * K} height="94"></rect>
        <path class="contour" d="M 110 190 H 120 V 172 H 186 A 8 8 0 0 1 194 180 V 196 H 214 V 222 H 150 L 132 208 H 120 V 190"></path>
        <circle class="hole" cx="110" cy="190" r="2.5"></circle>
        <circle class="bolt" cx="230" cy="164" r="4.5"></circle>
        <circle class="bolt" cx="230" cy="230" r="4.5"></circle>
      </g>

      <!-- 活動量爪＋本體＋液晶讀數（動畫時整組左右移動） -->
      <g class="slider" data-slider style={`--open: ${(OPEN - MEASURE) * K}px`}>
        <polygon class="steel" points={pts([[XS, 134], [XS + 52, 134], [XS + 52, 176], [XS + 16, 262], [XS + 6, 262], [XS, 252]])}></polygon>
        <polygon class="steel" points={pts([[XS, 100], [XS - 30, 100], [XS - 5, 50], [XS, 58]])}></polygon>
        <rect class="metal" x={XS + 60} y="80" width="18" height="9" rx="2"></rect>
        <rect class="body" x={XS - 2} y="88" width="214" height="58" rx="7"></rect>
        <rect class="bezel" x={XS + 52} y="95" width="124" height="44" rx="3"></rect>
        <rect class="lcd-bg" x={XS + 57} y="100" width="114" height="34" rx="2"></rect>
        <text class="lcd" x={XS + 146} y="126" text-anchor="end" data-reading>{MEASURE.toFixed(2)}</text>
        <text class="lcd-unit" x={XS + 150} y="126">mm</text>
        <circle class="btn-c" cx={XS + 24} cy="106" r="7"></circle>
        <text class="btn-t" x={XS + 24} y="108.5" text-anchor="middle">ON</text>
        <circle class="btn-c" cx={XS + 24} cy="129" r="7"></circle>
        <text class="btn-t" x={XS + 24} y="131.5" text-anchor="middle">0</text>
        <circle class="btn-c" cx={XS + 194} cy="117" r="7"></circle>
        <text class="btn-t" x={XS + 194} y="119.5" text-anchor="middle">mm</text>
        <rect class="metal" x={XS + 10} y="146" width="30" height="10" rx="2"></rect>
        <path class="knurl" d={`M ${XS + 15} 147 v 8 M ${XS + 20} 147 v 8 M ${XS + 25} 147 v 8 M ${XS + 30} 147 v 8 M ${XS + 35} 147 v 8`}></path>
      </g>

      <!-- 量測完成後出現的尺寸線 -->
      <g class="dim">
        <path class="dim-ext" d={`M ${X0} 266 V 292 M ${XS} 266 V 292`}></path>
        <path class="dim-line" d={`M ${X0} 284 H ${XS}`} pathLength="1"></path>
        <path class="dim-arrow" d={`M ${X0} 284 l 9 -3.5 v 7 Z M ${XS} 284 l -9 -3.5 v 7 Z`}></path>
        <text class="dim-text" x={(X0 + XS) / 2} y="277" text-anchor="middle">{MEASURE.toFixed(2)}</text>
      </g>
    </svg>
  </div>

  <figcaption>
    <span>{caption}</span>
    <button type="button" class="replay" data-replay hidden>重新量測</button>
  </figcaption>
</figure>

<style>
  .cal-view {
    overflow: hidden;
  }
  svg {
    width: 100%;
    height: auto;
  }
  /* 手機：放大顯示量爪與液晶讀數，主尺右段裁掉 */
  @media (max-width: 560px) {
    svg {
      width: 158%;
      max-width: none;
    }
  }

  .steel {
    fill: url(#cal-steel);
    stroke: var(--c-ink);
    stroke-width: 0.9;
    stroke-linejoin: round;
  }
  .tick {
    stroke: var(--c-ink);
    stroke-width: 0.8;
  }
  .num {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--c-ink-2);
  }

  .part-edge {
    fill: #fff;
    stroke: var(--c-ink);
    stroke-width: 1.2;
    transition:
      stroke 0.3s,
      stroke-width 0.3s;
  }
  .contour {
    fill: none;
    stroke: var(--c-blue);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }
  .hole {
    fill: #fff;
    stroke: var(--c-blue);
    stroke-width: 1.2;
  }
  .bolt {
    fill: none;
    stroke: var(--c-ink-2);
    stroke-width: 0.9;
  }

  .body {
    fill: #2b3036;
  }
  .bezel {
    fill: #15181b;
  }
  .lcd-bg {
    fill: #c9d3c2;
  }
  .lcd {
    font-family: var(--font-mono);
    font-size: 23px;
    font-weight: 500;
    fill: #1c261b;
    font-variant-numeric: tabular-nums;
  }
  .lcd-unit {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: #1c261b;
  }
  .btn-c {
    fill: #454c54;
    stroke: #15181b;
  }
  .btn-t {
    font-family: var(--font-mono);
    font-size: 6px;
    fill: #e7eaed;
  }
  .metal {
    fill: #a3acb4;
    stroke: var(--c-ink);
    stroke-width: 0.6;
  }
  .knurl {
    stroke: #5d6670;
    stroke-width: 0.8;
  }

  .dim-ext {
    stroke: var(--c-blue);
    stroke-width: 0.8;
  }
  .dim-line {
    stroke: var(--c-blue);
    stroke-width: 1;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .dim-arrow {
    fill: var(--c-blue);
  }
  .dim-text {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    fill: var(--c-blue);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--c-rule);
    font-size: 0.8125rem;
    color: var(--c-muted);
  }
  .replay {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--c-blue);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- 動畫狀態（只在支援且未要求減少動態時） ---- */
  @media (prefers-reduced-motion: no-preference) {
    /* 腳本接手前，先停在張開的位置，避免畫面跳動 */
    :global(.js) .cal:not(.is-animated) .slider {
      transform: translateX(var(--open));
    }
    :global(.js) .cal:not(.is-measured) .dim {
      opacity: 0;
    }
    :global(.js) .cal:not(.is-measured) .dim-line {
      stroke-dashoffset: 1;
    }
    .dim {
      transition: opacity 0.4s ease;
    }
    .dim-line {
      transition: stroke-dashoffset 0.6s ease 0.1s;
    }
    .cal.is-contact .part-edge {
      stroke: var(--c-blue);
      stroke-width: 2.4;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-caliper]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && !reduceMotion) {
    const slider = root.querySelector<SVGGElement>('[data-slider]')!;
    const reading = root.querySelector<SVGTextElement>('[data-reading]')!;
    const replay = root.querySelector<HTMLButtonElement>('[data-replay]')!;
    const open = Number(root.dataset.open);
    const measure = Number(root.dataset.measure);
    const k = Number(root.dataset.k);
    const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    let frame = 0;

    // 把活動量爪移到指定讀數（mm），並更新液晶數字
    const setReading = (mm: number) => {
      slider.style.transform = `translateX(${(mm - measure) * k}px)`;
      reading.textContent = mm.toFixed(2);
    };

    const run = () => {
      cancelAnimationFrame(frame);
      root.classList.remove('is-measured', 'is-contact');
      setReading(open);
      const start = performance.now() + 600;
      const duration = 1900;
      const step = (now: number) => {
        const t = Math.min(1, Math.max(0, (now - start) / duration));
        setReading(open - (open - measure) * easeInOut(t));
        if (t < 1) {
          frame = requestAnimationFrame(step);
        } else {
          root.classList.add('is-contact', 'is-measured');
          window.setTimeout(() => root.classList.remove('is-contact'), 700);
        }
      };
      frame = requestAnimationFrame(step);
    };

    setReading(open);
    root.classList.add('is-animated');
    replay.hidden = false;
    replay.addEventListener('click', run);

    // 進入畫面才開始量測
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          run();
        }
      },
      { threshold: 0.4 },
    );
    observer.observe(root);
  }
</script>
