---
/**
 * 型錄風格的公司標記：藍色方塊中直排「明泉」，像型錄封面上的品牌章。
 */
import { company } from '../../../data/company';

const [first, second] = [...company.shortName];
---

<span class="badge" aria-hidden="true">
  <span>{first}</span>
  <span>{second}</span>
</span>

<style>
  .badge {
    display: inline-grid;
    place-content: center;
    flex: none;
    width: 40px;
    height: 40px;
    background: var(--c-blue);
    color: #fff;
    font-family: 'Noto Sans TC', var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.05;
    text-align: center;
  }
</style>
